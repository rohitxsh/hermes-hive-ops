#!/bin/bash
# hermes-webui (nesquena), in-process agent. Keep it on loopback (reach it with ssh -L) unless a firewall limits it.
# credentials.conf: LoadCredentialEncrypted=ui_password
set -euo pipefail
HERMES_WEBUI_PASSWORD=$(<"$CREDENTIALS_DIRECTORY/ui_password")
export HERMES_WEBUI_PASSWORD HERMES_WEBUI_HOST=127.0.0.1 HERMES_WEBUI_PORT=8787
export MEDIA_ALLOWED_ROOTS="$HOME/artifacts"     # HTML from publish-artifact, served behind the login
export HERMES_WEBUI_AGENT_DIR="$HOME/.hermes/hermes-agent" PATH="$HOME/.local/bin:$PATH"
cd "$HOME/hermes-webui"
exec /usr/bin/python3 bootstrap.py --foreground --host 127.0.0.1 8787
