# Copy to setup/settings.env and fill in. Nothing secret goes here: secrets are sealed with systemd-creds (see README).
OWNER_NAME="the owner"                 # how agents refer to the person they work for
OWNER_CHAT_USER_ID=""                  # your Discord user ID: memory-learn labels your messages as the owner's
ADMIN_DELIVER=""                       # where maintenance alerts go, e.g. discord:<channel id> (empty: local only)
ADMIN_PROFILE="default"                # the profile that administers this machine and runs the maintenance jobs
LOCKED_PROFILES=""                     # space-separated web-only chat profiles (no terminal, files, memory or skills)
PRIVATE_PROFILES=""                    # profiles whose second-brain notes other profiles must not read
GITHUB_OWNER=""                        # GitHub login whose "approved" PR comments resume a waiting Kanban card
ATTENTION_DOMAINS=""                   # domains whose expiry the attention check should watch
INSTALL_DEVTOOLS="claude codex gh"     # any of: claude codex gh flutter supabase
