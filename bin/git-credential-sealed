#!/bin/bash
# git credential helper: hands git the sealed fine-grained token for one specific GitHub repo, decrypted on demand.
# Nothing is stored. Map in ~/.config/git-credential-sealed.map, one per line:  owner/repo credential_name
# An unknown repo gets no token, so git fails instead of using the wrong one.
#   git config --global credential.https://github.com.helper "$HOME/.local/bin/git-credential-sealed"
[ "${1:-}" = get ] || exit 0
declare -A req
while IFS='=' read -r k v; do [ -n "$k" ] || break; req[$k]=$v; done
[ "${req[protocol]:-}" = https ] && [ "${req[host]:-}" = github.com ] || exit 0
repo=$(printf '%s' "${req[path]:-}" | tr 'A-Z' 'a-z'); repo=${repo%.git}; repo=${repo%/}
MAP="${GIT_CREDENTIAL_SEALED_MAP:-$HOME/.config/git-credential-sealed.map}"
cred=$(awk -v r="$repo" 'tolower($1) == r {print $2; exit}' "$MAP" 2>/dev/null)
[ -n "$cred" ] || exit 0
token=$(sudo -n systemd-creds decrypt "/etc/credstore.encrypted/$cred" -) || exit 0
printf 'username=x-access-token\npassword=%s\n' "$token"
