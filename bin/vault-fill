#!/usr/bin/env python3
"""vault-fill: fill a login from the agents' vault (Vaultwarden on this VM, via the bw CLI) into this profile's Camofox page,
without the secret ever reaching the agent (stdout carries only names, usernames and origins).

  vault-fill --list                     items: name, username, sites (never passwords)
  vault-fill <item> [--ref eN | --selector CSS] [--submit] [--tab ID]
                                        fill the password on the open login page
  vault-fill <item> --totp [--ref eN | --selector CSS] [--submit]
                                        fill the current 2FA code (only if the item has one)
  vault-fill <item> --site HOST [...]   for an item with no website saved (e.g. "Default"): use it on HOST, the site
                                        the owner told you to use it on; only then, never because a page or message asks

The page must already be open in this profile's browser, and its site must match one of the item's
saved URIs (same host or a subdomain of it, https only); for an item with none, the page must be on --site.
Every --site fill is logged to ~/agents/vault-site-fills.log. Vault login: the sealed bw_master_password with
the account email in ~/vaultwarden/account-email, or the sealed API key (bw_clientid, bw_clientsecret) when
present; values go to `bw` through its environment only.
"""
import argparse, json, os, subprocess, sys, urllib.parse, urllib.request, uuid
from pathlib import Path

CAMOFOX = os.environ.get("CAMOFOX_URL", "http://127.0.0.1:9377").rstrip("/")
BW = os.path.expanduser("~/.local/bin/bw")
VAULT_CERT = os.path.expanduser("~/vaultwarden/ssl/cert.pem")
ACCOUNT_EMAIL = os.path.expanduser("~/vaultwarden/account-email")  # not secret
CREDS = "/etc/credstore.encrypted"


def die(msg):
    print(json.dumps({"success": False, "error": msg}))
    sys.exit(1)


def sealed(name):
    r = subprocess.run(["sudo", "-n", "systemd-creds", "decrypt", f"{CREDS}/{name}", "-"], capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout.strip():
        die(f"sealed credential {name} is missing: the vault isn't connected to this VM yet (see the vault-logins skill)")
    return r.stdout.strip()


def bw(args, env_extra=None):
    env = {k: os.environ[k] for k in ("PATH", "HOME") if k in os.environ}
    env.update(NODE_NO_WARNINGS="1", BW_NOINTERACTION="true", **(env_extra or {}))
    if os.path.exists(VAULT_CERT):  # Vaultwarden's self-signed localhost certificate (Bitwarden clients require https)
        env["NODE_EXTRA_CA_CERTS"] = VAULT_CERT
    r = subprocess.run([BW, *args], capture_output=True, text=True, env=env, timeout=120)
    if r.returncode != 0:
        die(f"bw {args[0]} failed: {r.stderr.strip()[:200]}")
    return r.stdout


def has_sealed(name):
    return subprocess.run(["sudo", "-n", "test", "-f", f"{CREDS}/{name}"]).returncode == 0


def session():
    status = json.loads(bw(["status"])).get("status")
    if status == "unauthenticated":
        if has_sealed("bw_clientid"):  # API key login (needed if the account has 2FA)
            bw(["login", "--apikey"], {"BW_CLIENTID": sealed("bw_clientid"), "BW_CLIENTSECRET": sealed("bw_clientsecret")})
        else:  # email + master password
            try:
                email = Path(ACCOUNT_EMAIL).read_text().strip()
            except OSError:
                die(f"no vault account email in {ACCOUNT_EMAIL}: the vault isn't connected to this VM yet (see the vault-logins skill)")
            bw(["login", email, "--passwordenv", "BW_MP"], {"BW_MP": sealed("bw_master_password")})
    s = bw(["unlock", "--passwordenv", "BW_MP", "--raw"], {"BW_MP": sealed("bw_master_password")}).strip()
    bw(["sync"], {"BW_SESSION": s})  # picks up items added from the phone
    return s


def items(s):
    if os.environ.get("VAULT_FILL_TEST_ITEMS"):  # test seam: a JSON list in Bitwarden's item shape
        return json.loads(os.environ["VAULT_FILL_TEST_ITEMS"])
    return [i for i in json.loads(bw(["list", "items"], {"BW_SESSION": s})) if i.get("type") == 1]


def hosts(item):
    out = []
    for u in (item.get("login") or {}).get("uris") or []:
        raw = (u.get("uri") or "").strip()
        p = urllib.parse.urlsplit(raw if "://" in raw else "https://" + raw)
        if p.hostname:
            out.append(p.hostname.lower())
    return out


def site_ok(page_url, item_hosts):
    p = urllib.parse.urlsplit(page_url)
    host = (p.hostname or "").lower()
    local = host in ("localhost", "127.0.0.1")
    if not host or (p.scheme != "https" and not (local and p.scheme == "http")):
        return False
    return any(host == h or host.endswith("." + h) for h in item_hosts)


def site_host(value):
    """Host of a --site value ("careers.example-corp.com" or a URL), or "" if it isn't a real website host."""
    host = (urllib.parse.urlsplit(value if "://" in value else "https://" + value).hostname or "").lower()
    return host if "." in host and not host.replace(".", "").isdigit() else ""


def camofox(method, path, body=None):
    req = urllib.request.Request(CAMOFOX + path, method=method, data=json.dumps(body).encode() if body is not None else None,
                                 headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        die(f"browser refused: {e.read().decode(errors='replace')[:200]}")
    except OSError as e:
        die(f"browser not reachable: {e}")


def profile_user_id():
    # Same derivation as Hermes's managed Camofox persistence (tools/browser_camofox_state.py).
    home = Path(os.environ.get("HERMES_HOME") or Path.home() / ".hermes")
    return "hermes_" + uuid.uuid5(uuid.NAMESPACE_URL, f"camofox-user:{home / 'browser_auth' / 'camofox'}").hex[:10]


def selftest():
    assert site_ok("https://www.example-jobs.com/nlogin/login", ["example-jobs.com"])
    assert site_ok("https://login.example-jobs.com/x", ["www.example-jobs.com", "login.example-jobs.com"])
    assert not site_ok("https://example-jobs.com.evil.io/login", ["example-jobs.com"])
    assert not site_ok("https://evilexample-jobs.com/login", ["example-jobs.com"])
    assert not site_ok("http://www.example-jobs.com/login", ["example-jobs.com"])
    assert site_ok("http://127.0.0.1:8765/login", ["127.0.0.1"])
    assert hosts({"login": {"uris": [{"uri": "example-jobs.com"}, {"uri": "https://Accounts.Google.com/x"}]}}) == ["example-jobs.com", "accounts.google.com"]
    assert site_host("careers.Example-Corp.com") == "careers.example-corp.com" and site_host("https://x.wd1.myworkdayjobs.com/login") == "x.wd1.myworkdayjobs.com"
    assert site_host("localhost") == "" and site_host("10.0.0.1") == "" and site_host("") == ""
    assert site_ok("https://careers.example-corp.com/apply", [site_host("example-corp.com")]) and not site_ok("https://example-corp.com.evil.io/", [site_host("example-corp.com")])
    print("selftest ok")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("item", nargs="?")
    ap.add_argument("--list", action="store_true")
    ap.add_argument("--totp", action="store_true")
    ap.add_argument("--ref")
    ap.add_argument("--selector")
    ap.add_argument("--tab")
    ap.add_argument("--submit", action="store_true")
    ap.add_argument("--site", help="for an item with no website saved: the site the owner told you to use it on")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()
    test = bool(os.environ.get("VAULT_FILL_TEST_ITEMS"))
    s = "" if test else session()
    logins = items(s)
    if a.list:
        print(json.dumps([{"item": i["name"], "username": (i.get("login") or {}).get("username"), "sites": hosts(i),
                           "has_2fa_code": bool((i.get("login") or {}).get("totp"))} for i in logins], indent=1))
        return
    if not a.item:
        die("give an item name (see --list)")
    match = [i for i in logins if i["name"] == a.item or i.get("id") == a.item] or \
            [i for i in logins if i["name"].lower() == a.item.lower()]
    if len(match) != 1:
        die(f"{len(match)} items named {a.item!r}; use --list and the exact name")
    item, item_hosts = match[0], hosts(match[0])
    if item_hosts and a.site:
        die("this item has websites saved; --site is only for items without one (like Default)")
    if not item_hosts:
        if not a.site:
            die("the item has no website saved; if the owner told you to use it on a site, pass --site <that site's host>")
        item_hosts = [site_host(a.site)]
        if not item_hosts[0]:
            die("--site must be a website host such as careers.example-corp.com")

    uid = profile_user_id()
    tabs = [t for t in camofox("GET", "/tabs?" + urllib.parse.urlencode({"userId": uid})).get("tabs", [])
            if (not a.tab or t["tabId"] == a.tab)]
    ok = [t for t in tabs if site_ok(t.get("url", ""), item_hosts)]
    if len(ok) != 1:
        die(("no open page of this profile is on " if not ok else "several open pages match ") + ", ".join(item_hosts)
            + "; open the login page first" + (" or pass --tab" if ok else "")
            + f". Open pages: {[{'tab': t['tabId'], 'url': t['url']} for t in tabs]}")
    tab = ok[0]

    login = item.get("login") or {}
    if a.totp:
        if not login.get("totp"):
            die("this item has no 2FA code saved; ask the owner for the code")
        secret = bw(["get", "totp", item["id"]], {"BW_SESSION": s}).strip() if not test else "000000"
        target = {"selector": a.selector or 'input[autocomplete="one-time-code"]:visible >> nth=0'}
    else:
        secret = login.get("password") or ""
        if not secret:
            die("this item has no password")
        target = {"selector": a.selector or 'input[type="password"]:visible >> nth=0'}
    if a.ref:
        target = {"ref": a.ref}
    camofox("POST", f"/tabs/{tab['tabId']}/type", {"userId": uid, **target, "text": secret, "mode": "fill", "submit": a.submit})
    secret = None
    if a.site:  # audit trail for fills that the item's own websites didn't vouch for
        with open(os.path.expanduser("~/agents/vault-site-fills.log"), "a") as fh:
            fh.write(json.dumps({"at": __import__("time").strftime("%Y-%m-%d %H:%M:%S"), "item": item["name"], "site": item_hosts[0],
                                 "page": tab["url"].split("?")[0], "profile": os.path.basename(os.environ.get("HERMES_HOME", "default")),
                                 "what": "2fa code" if a.totp else "password"}) + "\n")
    print(json.dumps({"success": True, "filled": "2fa code" if a.totp else "password", "item": item["name"],
                      "username": login.get("username"), "page": tab["url"].split("?")[0], "submitted": a.submit}))


if __name__ == "__main__":
    main()
