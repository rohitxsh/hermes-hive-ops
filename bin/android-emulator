#!/bin/bash
# android-emulator up|down|status: a headless Android 14 phone (AVD agents_api34) for Maestro/adb tests. One at a time.
export PATH=$HOME/.local/bin:$PATH
SDK=$HOME/.local/opt/android-sdk; [ -d "$HOME/Android/Sdk" ] && SDK=$HOME/Android/Sdk
booted(){ [ "$(adb shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = 1 ]; }
case "${1:-status}" in
  up)
    booted && { echo "already running"; exit 0; }
    log="${TMPDIR:-/tmp}/android-emulator.log"
    cmd="'$SDK/emulator/emulator' -avd agents_api34 -no-window -no-audio -no-boot-anim -no-snapshot-save -gpu swiftshader_indirect -memory 2048"
    # /dev/kvm belongs to group kvm; a process started before the user joined it (the gateway) gets the group via sg
    if id -nG | grep -qw kvm; then nohup sh -c "$cmd" >"$log" 2>&1 & else nohup sg kvm -c "$cmd" >"$log" 2>&1 & fi
    for i in $(seq 1 120); do
      booted && { echo "booted"; exit 0; }
      [ "$i" -gt 5 ] && ! pgrep -f "emulator.*agents_api34" >/dev/null && { echo "emulator exited; see $log"; tail -3 "$log"; exit 1; }
      sleep 3
    done
    echo "did not boot in 6 minutes; see $log"; exit 1 ;;
  down) adb emu kill >/dev/null 2>&1; sleep 3; pkill -f "emulator.*agents_api34" 2>/dev/null; echo "stopped" ;;
  status) booted && echo "running" || echo "not running" ;;
  *) echo "usage: android-emulator up|down|status"; exit 2 ;;
esac
