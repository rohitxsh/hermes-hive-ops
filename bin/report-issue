#!/usr/bin/env python3
"""report-issue "<what failed, where, what you already tried>"

Adds a problem to the assistant's issue list (~/agents/issues/open.md); the issue digest posts it to the
assistant's channel within 10 minutes. Use it for failures the owner or the assistant should know about
(a site or tool that keeps failing, a login that broke, missing access), not for one-off hiccups.
"""
import datetime
import json
import os
import sys

text = " ".join(sys.argv[1:]).strip()
if not text or text in ("-h", "--help"):
    sys.exit(__doc__)
hermes_dir = os.path.realpath(os.path.expanduser("~/.hermes"))
home = os.path.realpath(os.environ.get("HERMES_HOME") or hermes_dir)
profile = "default" if home == hermes_dir else os.path.basename(home)
path = os.path.expanduser("~/agents/issues/reported.jsonl")
os.makedirs(os.path.dirname(path), exist_ok=True)
with open(path, "a") as fh:
    fh.write(json.dumps({"time": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
                         "profile": profile, "text": text[:1000]}) + "\n")
print("Reported: the assistant will see it in its issue list within 10 minutes.")
