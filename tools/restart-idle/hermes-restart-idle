#!/usr/bin/python3
"""hermes-restart-idle [--max-wait SECONDS] [--webui] [--dry-run] [--force]

Gracefully restart this VM's Hermes gateway only when it is idle, so chat messages don't land in the restart
window (where Hermes can refuse them with "runtime_draining"). Idle = no agent turn running (no live turn lease in
any profile's state.db) and no inbound chat message for QUIET seconds; checked every 15 s. A state database
it can't read counts as busy (unknown is never idle). If it is still busy after --max-wait (default 1800 s; 3 h with
Kanban tasks running, --max-wait-kanban), it does NOT restart: it logs and reports one issue and exits 3, and the
restart stays the admin's call. A restart under running Kanban tasks books them crashed and starts them over (upstream
issue NousResearch/hermes-agent#148593). --force restarts anyway after the wait (outage recovery only; Hermes still
lets running turns finish first). --webui also restarts the
web UI. Run it as root through systemd-run so it survives the restart it triggers:
  sudo systemd-run --unit hermes-restart-idle --collect ~/.local/bin/hermes-restart-idle --webui
"""
import argparse
import datetime
import glob
import os
import pwd
import sqlite3
import subprocess
import sys
import time

# it runs as root (systemd-run), so "~" would be /root: use the home of whoever owns this script
HERMES_DIR = os.path.join(pwd.getpwuid(os.stat(os.path.realpath(__file__)).st_uid).pw_dir, ".hermes")
GATEWAY_LOG = os.path.join(HERMES_DIR, "logs", "gateway.log")
LOG = os.path.join(HERMES_DIR, "logs", "restart-idle.log")
UNIT = "agent-worker@hermes"
QUIET = 30


def log(msg):
    line = f"{datetime.datetime.now():%Y-%m-%d %H:%M:%S} {msg}"
    print(line)
    try:
        with open(LOG, "a") as fh:
            fh.write(line + "\n")
    except OSError:
        pass


def count(dbs, sql, args=()):
    """Sum of a count over the databases, or None when any of them can't be read: unknown must never look idle.
    A database without the table (an older or unused profile) counts 0."""
    n = 0
    for db in dbs:
        try:
            con = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=5)
            try:
                n += con.execute(sql, args).fetchone()[0]
            finally:
                con.close()
        except sqlite3.OperationalError as e:
            if "no such table" not in str(e):
                return None
        except sqlite3.Error:
            return None
    return n


def live_leases(now):
    return count([os.path.join(HERMES_DIR, "state.db")] + glob.glob(os.path.join(HERMES_DIR, "profiles", "*", "state.db")),
                 "select count(*) from session_turn_leases where expires_at > ?", (now,))


def kanban_running():
    """Kanban tasks a worker is running right now. Workers are separate processes that talk to the gateway, so a
    restart under them fails the run ("Gateway disconnected", then "runtime_draining") and counts against its retries."""
    return count([os.path.join(HERMES_DIR, "kanban.db")] + glob.glob(os.path.join(HERMES_DIR, "kanban", "boards", "*", "kanban.db")),
                 "select count(*) from tasks where status = 'running'")


def last_inbound():
    """Epoch of the latest inbound chat message: the newest user message in any profile's state.db (Hermes >= 0.23 no
    longer logs "inbound message:" at INFO), or the gateway log line older versions write, whichever is later."""
    best = 0.0
    for db in [os.path.join(HERMES_DIR, "state.db")] + glob.glob(os.path.join(HERMES_DIR, "profiles", "*", "state.db")):
        try:
            con = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=5)
            best = max(best, con.execute("select coalesce(max(timestamp), 0) from messages where role = 'user'").fetchone()[0] or 0)
            con.close()
        except sqlite3.Error:
            continue
    try:
        with open(GATEWAY_LOG, "rb") as fh:
            fh.seek(max(0, os.path.getsize(GATEWAY_LOG) - 400_000))
            lines = fh.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return best
    for line in reversed(lines):
        if "inbound message:" in line:
            try:
                return max(best, time.mktime(time.strptime(line[:19], "%Y-%m-%d %H:%M:%S")))
            except ValueError:
                break
    return best


def systemctl(*args):
    cmd = ["systemctl", *args] if os.geteuid() == 0 else ["sudo", "-n", "systemctl", *args]
    return subprocess.run(cmd, capture_output=True, text=True)


def main_pid():
    return systemctl("show", "-p", "MainPID", "--value", UNIT).stdout.strip()


def is_idle(leases, tasks, quiet_for):
    return leases == 0 and tasks == 0 and quiet_for >= QUIET   # None (unreadable) is never 0


def report(text):
    """One issue for the VM assistant, filed as the owner (this runs as root)."""
    owner = pwd.getpwuid(os.stat(os.path.realpath(__file__)).st_uid)
    tool = os.path.join(owner.pw_dir, ".local", "bin", "report-issue")
    if os.path.exists(tool):
        cmd = [tool, text] if os.geteuid() != 0 else ["runuser", "-u", owner.pw_name, "--", tool, text]
        subprocess.run(cmd, capture_output=True)


def selftest():
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        ok, bad, old = (os.path.join(d, n) for n in ("ok.db", "bad.db", "old.db"))
        c = sqlite3.connect(ok); c.execute("create table tasks (status)"); c.execute("insert into tasks values ('running')"); c.commit(); c.close()
        sqlite3.connect(old).close()                                  # no tasks table: an unused profile, counts 0
        with open(bad, "w") as fh:
            fh.write("not a database " * 200)
        q = "select count(*) from tasks where status = 'running'"
        assert count([ok, old], q) == 1
        assert count([ok, bad], q) is None and count([os.path.join(d, "missing", "x.db")], q) is None
    assert not is_idle(None, 0, 999) and not is_idle(0, None, 999) and not is_idle(0, 1, 999) and is_idle(0, 0, 999)
    print("hermes-restart-idle selftest ok")


def main():
    if "--selftest" in sys.argv:
        return selftest()
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--max-wait", type=int, default=1800)
    ap.add_argument("--max-wait-kanban", type=int, default=3 * 3600,
                    help="how long to wait for running Kanban tasks before restarting anyway (default 3 h)")
    ap.add_argument("--webui", action="store_true")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--force", action="store_true", help="restart anyway after the wait (outage recovery only)")
    a = ap.parse_args()
    start = time.time()
    while True:
        now = time.time()
        leases, quiet_for, tasks = live_leases(now), now - last_inbound(), kanban_running()
        if a.dry_run:
            print(f"turns running: {leases}; Kanban tasks running: {tasks}; last inbound message {quiet_for:.0f} s ago; "
                  f"idle: {is_idle(leases, tasks, quiet_for)}  (None = state unreadable, counted as busy)")
            return
        if is_idle(leases, tasks, quiet_for):
            log(f"idle (no turns running, {quiet_for:.0f} s since the last message): restarting")
            break
        if now - start >= (a.max_wait_kanban if tasks != 0 else a.max_wait):
            busy = f"{leases} turn(s), {tasks} Kanban task(s) running (None = unreadable)"
            if a.force:
                log(f"still busy after {now - start:.0f} s ({busy}): --force, restarting anyway; running turns finish first")
                break
            log(f"still busy after {now - start:.0f} s ({busy}): NOT restarting; the restart is still pending")
            report(f"hermes-restart-idle: the gateway restart is still pending after {now - start:.0f} s because the VM "
                   f"stayed busy ({busy}). Queue it again when idle, or rerun with --force only for outage recovery.")
            return 3
        time.sleep(15)
    old = main_pid()
    systemctl("kill", "-s", "SIGUSR1", "--kill-whom=main", UNIT)
    for _ in range(150):
        time.sleep(4)
        new = main_pid()
        if new not in (old, "", "0"):
            break
    if a.webui and systemctl("is-enabled", "agent-worker@webui").stdout.strip() == "enabled":  # never revive a removed WebUI
        systemctl("restart", "agent-worker@webui")
    # the dashboard is a Hermes process too: without this it keeps serving pre-update code
    if systemctl("is-active", "agent-worker@dashboard").stdout.strip() == "active":
        systemctl("restart", "agent-worker@dashboard")
    log(f"gateway pid {old} -> {main_pid()}, {systemctl('is-active', UNIT).stdout.strip()}" + (", webui restarted" if a.webui else ""))


if __name__ == "__main__":
    sys.exit(main())
