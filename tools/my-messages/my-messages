#!/usr/bin/python3
"""my-messages [N] [--profile NAME] [--search TEXT] [--full] [--all-sources]

Your last N messages to the agents on this VM (default 10), oldest first, from every profile's session
history: when, which profile, where (server / channel / thread), and what you wrote. Only messages typed in
chat (Discord, the web UI, Telegram, the CLI...); prompts from one-shots, cron jobs, Kanban and subagents
are skipped unless --all-sources. Read-only.
"""
import argparse
import datetime
import glob
import os
import re
import sqlite3
import sys

H = os.path.expanduser("~/.hermes")
SKIP = ("oneshot", "cron", "kanban", "subagent")  # prompts written by tools and agents, not by you
# Turns Hermes injects as "user" messages (agent/context_compressor.py, agent/conversation_compression.py).
SYNTHETIC = ("[CONTEXT COMPACTION", "[CONTEXT SUMMARY]:", "Continue from the compressed conversation context above.",
             "[Your active task list was preserved across context compression]", "[System: Your previous response was truncated",
             "[System: The previous response was cut off", "[System: Your previous tool call", "[IMPORTANT: Background process ",
             "You've reached the maximum number of tool-calling iterations allowed.", "[SKILL_PRUNED:",
             "[System note:", "[System record:", "[System:", "[ASYNC DELEGATION")
GATEWAY_MARK = "generated by the Hermes gateway, not written by a human user"


def unwrap(text):
    """The part the user actually typed: drop the gateway's context wrappers (triggering-message header,
    recent-channel block before [New message], out-of-band relay envelope) and the '[Name] ' speaker prefix."""
    t = (text or "").strip()
    t = re.sub(r"^\[Triggering message id: `[^`]*`[^\]]*\]\s*", "", t)
    if t.startswith("[OUT-OF-BAND USER MESSAGE"):
        body = t.rsplit("[/OUT-OF-BAND USER MESSAGE]", 1)[0].rstrip()
        t = body.rsplit(chr(10) * 2, 1)[-1]
    if t.startswith("[Recent channel messages]"):
        t = t.rsplit("[New message]", 1)[-1] if "[New message]" in t else t[len("[Recent channel messages]"):]
    return re.sub(r"^\[[^\]\n]{1,40}\] ", "", t.strip())


def synthetic(text):
    """True for turns Hermes wrote itself (system notes and records, delegation reports, compaction markers)."""
    return GATEWAY_MARK in (text or "") or unwrap(text).startswith(SYNTHETIC)


def databases():
    yield "default", os.path.join(H, "state.db")
    for db in sorted(glob.glob(os.path.join(H, "profiles", "*", "state.db"))):
        yield os.path.basename(os.path.dirname(db)), db


def clean(text):
    """What the user typed, on one line."""
    return re.sub(r"\s+", " ", unwrap(text)).strip()


def fetch(n, profile=None, search=None, all_sources=False):
    rows = []
    for name, db in databases():
        if profile and profile != name or not os.path.exists(db):
            continue
        sql = ("select m.timestamp, s.source, coalesce(s.display_name, s.title, ''), m.content from messages m "
               "join sessions s on s.id = m.session_id where m.role = 'user' and m.content is not null "
               "and coalesce(m._compressed_summary, 0) = 0")  # context-compaction summaries are stored as user turns
        args = []
        for prefix in SYNTHETIC:
            sql += " and substr(m.content, 1, ?) != ?"
            args += [len(prefix), prefix]
        if not all_sources:
            sql += f" and coalesce(s.source, '') not in ({','.join('?' * len(SKIP))})"
            args += SKIP
        if search:
            sql += " and m.content like ?"
            args.append(f"%{search}%")
        sql += " order by m.timestamp desc limit ?"
        args.append(n * 5)  # headroom: duplicate copies of a turn, and wrapped synthetic turns dropped below
        try:
            con = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=5)
            rows += [(ts, name, src, where, content) for ts, src, where, content in con.execute(sql, args)
                     if all_sources or not synthetic(content)]
            con.close()
        except sqlite3.Error as exc:
            print(f"(skipped {name}: {exc})", file=sys.stderr)
    seen, out = set(), []
    for row in sorted(rows, key=lambda r: -(r[0] or 0)):
        key = (round(row[0] or 0), clean(row[4])[:200])  # the same message can be stored in two profiles' history
        if key not in seen:
            seen.add(key)
            out.append(row)
    return list(reversed(out[:n]))


def main(argv):
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("n", nargs="?", type=int, default=10)
    ap.add_argument("--profile")
    ap.add_argument("--search")
    ap.add_argument("--full", action="store_true", help="don't shorten long messages")
    ap.add_argument("--all-sources", action="store_true")
    a = ap.parse_args(argv)
    rows = fetch(max(1, a.n), a.profile, a.search, a.all_sources)
    for ts, name, src, where, content in rows:
        text = clean(content)
        if not a.full and len(text) > 300:
            text = text[:297] + "..."
        when = datetime.datetime.fromtimestamp(ts).strftime("%a %d %b %H:%M") if ts else "?"
        print(f"[{when}] {name} · {where or src}\n  {text}\n")
    print(f"{len(rows)} message(s)" + (f" matching '{a.search}'" if a.search else "") + (f" in {a.profile}" if a.profile else " across all profiles"))


def selftest():
    import tempfile
    global H
    H = tempfile.mkdtemp()
    os.makedirs(os.path.join(H, "profiles", "jobs"))
    for db, rows in ((os.path.join(H, "state.db"), [(1, "discord", "srv / #assistant", "[Owner] hello there"),
                                                   (2, "oneshot", "", "[Question relayed ...]"),
                                                   (3, "discord", "srv / #assistant", "[Owner] second")]),
                     (os.path.join(H, "profiles", "jobs", "state.db"), [(3, "discord", "srv / #jobs", "[Owner] second"),
                                                                           (4, "cron", "", "AUTO MODE run"),
                                                                           (5, "webui", "web", "apply to acme"),
                                                                           (6, "discord", "srv / #jobs", "[CONTEXT COMPACTION] Earlier turns"),
                                                                           (7, "discord", "srv / #jobs", "Continue from the compressed conversation context above. x"),
                                                                           (8, "discord", "srv / #jobs", "[Your active task list was preserved across context compression] - x")])):
        con = sqlite3.connect(db)
        con.execute("create table sessions (id text, source text, display_name text, title text)")
        con.execute("create table messages (session_id text, role text, content text, timestamp real, _compressed_summary int)")
        for i, (ts, src, where, text) in enumerate(rows):
            con.execute("insert into sessions values (?,?,?,?)", (f"s{i}", src, where, None))
            con.execute("insert into messages values (?,?,?,?,?)", (f"s{i}", "user", text, ts, int(text.startswith("[CONTEXT"))))
        con.commit()
        con.close()
    got = [(r[1], clean(r[4])) for r in fetch(10)]
    assert got == [("default", "hello there"), ("default", "second"), ("jobs", "apply to acme")], got  # oneshot/cron skipped, duplicate dropped
    assert [clean(r[4]) for r in fetch(1)] == ["apply to acme"]                # newest N, oldest first
    assert len(fetch(2)) == 2                                                     # duplicates don't eat into N
    nl = chr(10)
    assert clean("[Triggering message id: `300000000000000001` — use as `message_id` for reply.]" + nl + nl + "[Owner] apply to acme") == "apply to acme"
    assert clean("[Recent channel messages]" + nl + "[Owner] old context" + nl + nl + "[New message]" + nl + "[Owner] note: example") == "note: example"
    assert clean("[OUT-OF-BAND USER MESSAGE — a direct message]" + nl + "Gateway message origin (JSON data):" + nl + '{"a": 1}' + nl
                 + "Do not guess." + nl + nl + "Done" + nl + "[/OUT-OF-BAND USER MESSAGE]") == "Done"
    assert synthetic('[Triggering message id: `["async_delegation","deleg_0fc1",""]` — use as `message_id`.]' + nl + nl
                     + "[Owner] [ASYNC DELEGATION BATCH COMPLETE — deleg_0fc1] results")
    assert synthetic("[System record: background delegation batch completed with failures]")
    assert synthetic("[System note: The following is recalled memory context, NOT new user input]")
    assert synthetic("x" + nl + "[This is a SYSTEM NOTIFICATION — generated by the Hermes gateway, not written by a human user.]")
    assert not synthetic("[Owner] Let's continue our research for swing")
    assert len(fetch(10, all_sources=True)) == 5
    assert [r[1] for r in fetch(10, profile="jobs")] == ["jobs", "jobs"]
    assert [clean(r[4]) for r in fetch(10, search="hello")] == ["hello there"]
    print("my-messages selftest ok")


if __name__ == "__main__":
    selftest() if sys.argv[1:] == ["--selftest"] else main(sys.argv[1:])
