#!/usr/bin/python3
"""attention (2026-11-01: inspired by always-on assistants; event-only alerts, no morning briefs). No model calls.

  attention check            scheduled (Hermes cron, no agent): prints only NEW events, so nothing is posted when
                             nothing happened: renewals due in <=7 days, <=1 day or expired (GitHub tokens, domains via RDAP
                             and any renewal_commands in config.json detected automatically, the rest from `renewals add`), items
                             waiting on a person for over 24 h (blocked Kanban cards, unanswered approvals), follow-ups
                             past due, and failed CI runs on the default branch of the GitHub checkouts under ~/work.
  waiting-on-me              everything currently waiting on a person, across all agents on this VM
  follow-up add --due DATE [--by PROFILE] TEXT | close ID [NOTE] | list
  renewals add --date DATE NAME [--note TEXT] | remove NAME | list
  attention pr-resume        scheduled every few minutes: unblocks a blocked Kanban card whose GitHub PR (full URL in the
                             card) was approved, merged, labelled `approved`, or approved in a comment by the owner
                             (config github_owner; unset: any human but the agents) after the card was blocked; the agent then carries on by itself
  attention --selftest
State and lists: ~/agents/attention/ (state.json, followups.json, renewals.json, config.json). Tokens are read only in
memory; only expiry dates are cached."""
import datetime as dt
import glob
import json
import os
import re
import sqlite3
import subprocess
import sys
import urllib.request

H = os.path.expanduser("~")
D = f"{H}/agents/attention"
NOW = dt.datetime.now().astimezone()
TODAY = NOW.date()


def load(name, default):
    try:
        return json.load(open(f"{D}/{name}"))
    except (OSError, ValueError):
        return default


def save(name, data):
    os.makedirs(D, exist_ok=True)
    tmp = f"{D}/{name}.tmp"
    json.dump(data, open(tmp, "w"), indent=1, default=str)
    os.replace(tmp, f"{D}/{name}")


def run(cmd, cwd=None, timeout=60):
    try:
        r = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout
    except (OSError, subprocess.TimeoutExpired):
        return 1, ""


def parse_date(s):
    """Date from 'YYYY-MM-DD...' (GitHub, RDAP, renewal commands) or 'DD/MM/YYYY'; None otherwise."""
    s = str(s).strip()
    m = re.match(r"(\d{4})-(\d{2})-(\d{2})", s) or re.match(r"(\d{2})/(\d{2})/(\d{4})", s)
    if not m:
        return None
    y, mo, d = (m.group(1), m.group(2), m.group(3)) if len(m.group(1)) == 4 else (m.group(3), m.group(2), m.group(1))
    try:
        return dt.date(int(y), int(mo), int(d))
    except ValueError:
        return None


def clip(text, n):
    """At most n characters, cut at a word boundary with an ellipsis (never mid-word)."""
    text = " ".join(str(text or "").split())
    if len(text) <= n:
        return text
    cut = text[:n - 1]
    return (cut.rsplit(" ", 1)[0] if " " in cut[n // 2:] else cut).rstrip(" ,;:.") + "…"


# ---------- renewals ----------
def github_expiries(cache):
    """{credential name: expiry date} for sealed github_* tokens; re-read once a day."""
    if cache.get("checked") == str(TODAY):
        return cache.get("dates", {})
    rc, out = run(["sudo", "-n", "ls", "/etc/credstore.encrypted"])
    dates = {}
    for name in sorted(n for n in out.split() if n.startswith("github") and "." not in n):
        rc, tok = run(["sudo", "-n", "systemd-creds", "decrypt", f"/etc/credstore.encrypted/{name}", "-"])
        tok = tok.strip()
        if rc or not tok:
            continue
        try:
            req = urllib.request.Request("https://api.github.com/rate_limit", headers={"Authorization": f"Bearer {tok}", "User-Agent": "attention"})
            exp = urllib.request.urlopen(req, timeout=20).headers.get("github-authentication-token-expiration")
        except Exception:
            exp = None
        finally:
            tok = None
        if exp:
            dates[name] = str(parse_date(exp))
    cache.update(checked=str(TODAY), dates=dates)
    return dates


def domain_expiry(domain):
    try:
        data = json.load(urllib.request.urlopen(f"https://rdap.org/domain/{domain}", timeout=20))
        return next((str(parse_date(e["eventDate"])) for e in data.get("events", []) if e.get("eventAction") == "expiration"), None)
    except Exception:
        return None


def renewals():
    items = {r["name"]: r for r in load("renewals.json", [])}
    cache = load("auto-cache.json", {})
    gh = github_expiries(cache.setdefault("github", {}))
    for name, date in gh.items():
        items.setdefault(f"GitHub token {name}", {"name": f"GitHub token {name}", "date": date,
                                                  "note": "regenerate it on GitHub, then re-seal it (owner types it on the VM)"})
    dcache = cache.setdefault("domains", {})
    if dcache.get("checked") != str(TODAY):
        dcache.update(checked=str(TODAY), dates={d: domain_expiry(d) for d in load("config.json", {}).get("domains", [])})
    for d, date in (dcache.get("dates") or {}).items():
        if date:
            items.setdefault(f"domain {d}", {"name": f"domain {d}", "date": date, "note": "renew at the registrar"})
    # config.json "renewal_commands": [{"name", "command", "pattern" (regex, group 1 = the date), "note"}], one run a day each
    ccache = cache.setdefault("commands", {})
    for c in load("config.json", {}).get("renewal_commands", []):
        if ccache.get(c["name"], {}).get("checked") != str(TODAY):
            rc, out = run(["bash", "-lc", c["command"]])
            m = re.search(c.get("pattern", r"(\d{4}-\d{2}-\d{2})"), out)
            ccache[c["name"]] = {"checked": str(TODAY), "date": m.group(1) if m else None}
        if ccache[c["name"]].get("date"):
            items.setdefault(c["name"], {"name": c["name"], "date": ccache[c["name"]]["date"], "note": c.get("note", "")})
    save("auto-cache.json", cache)
    return list(items.values())


def renewal_events(sent):
    out = []
    for r in renewals():
        date = parse_date(r["date"])
        if not date:
            continue
        days = (date - TODAY).days
        stage = "expired" if days < 0 else "1d" if days <= 1 else "7d" if days <= 7 else None
        key = f"renewal:{r['name']}:{date}:{stage}"
        if stage and key not in sent:
            when = f"expired {-days} day(s) ago" if days < 0 else "expires today" if days == 0 else f"expires in {days} day(s)"
            out.append((key, f"⏰ {r['name']} {when} ({date}). Next: {r.get('note') or 'renew it'}."))
    return out


# ---------- waiting on people ----------
def kanban_waiting():
    db = f"{H}/.hermes/kanban.db"
    if not os.path.exists(db):
        return []
    c = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=10)
    rows = c.execute(f"""select t.id, t.assignee, t.title, coalesce(t.block_kind, 'needs_input'),
        (select max(created_at) from task_events e where e.task_id = t.id and e.kind in ('blocked', 'block_loop_detected', 'scheduled')),
        (select payload from task_events e where e.task_id = t.id and e.kind in ('blocked', 'block_loop_detected', 'scheduled')
         order by created_at desc limit 1), t.status
        from tasks t where t.status in ('blocked', 'scheduled') or (t.status = 'triage' and {LOOP_HELD_SQL})""").fetchall()
    out = []
    for tid, who, title, kind, since, payload, status in rows:
        if kind in ("dependency", "transient"):
            continue
        reason = ""
        try:
            reason = (json.loads(payload or "{}") or {}).get("reason", "")
        except ValueError:
            pass
        if reason in ("initial_status", "blocked"):  # placeholder reasons Hermes records at creation
            reason = ""
        out.append({"id": tid, "who": who, "title": title, "since": since, "reason": reason, "status": status})
    return out


# A card Hermes moved to triage after repeated blocks of one kind (limit 2) still waits on a person; the loop-hold
# patch keeps it there until its owner routes it. Same test as that patch: the latest routing event is the loop.
LOOP_HELD_SQL = """(select e.kind from task_events e where e.task_id = t.id and e.kind in
    ('block_loop_detected', 'promoted', 'specified', 'decomposed', 'created') order by e.created_at desc, e.id desc limit 1)
    = 'block_loop_detected'"""


def resume_card(t, reason):
    """Unblock a blocked card; release a loop-held triage card to its assignee as written (reason as a comment)."""
    hermes = f"{H}/.local/bin/hermes"
    if t.get("status") != "triage":
        return run([hermes, "kanban", "unblock", t["id"], "--reason", reason])
    rc, out = run([hermes, "kanban", "comment", t["id"], reason])
    if rc:
        return rc, out
    try:
        f = sorted(glob.glob(f"{H}/.hermes/installs/*/facts.json"), key=os.path.getmtime)[-1]
        py = json.load(open(f))["packages"]["venv"]["environment"] + "/bin/python"
    except (IndexError, OSError, ValueError, KeyError):
        return 1, "no Hermes venv"
    code = ("import sys; from hermes_cli import kanban_db as kb, kanban_db_connect as kbc\n"
            "with kbc.connect_closing() as c: sys.exit(0 if kb.specify_triage_task(c, sys.argv[1]) else 1)")
    return run([py, "-I", "-c", code, t["id"]])


def implementer(conn, task_id, assignee):
    """Who asked for review on this card (latest review_requested), when the card now sits with someone else.
    An approved or reviewed PR goes back to them: the reviewer that parked the card can't act on it, and Hermes's
    duplicate-PR guard holds a reviewer that posted the PR link until a real handoff."""
    row = conn.execute("select payload from task_events where task_id = ? and kind = 'review_requested' "
                       "order by created_at desc, id desc limit 1", (task_id,)).fetchone()
    try:
        who = (json.loads(row[0] or "{}") or {}).get("implementer") if row else None
    except ValueError:
        who = None
    return who if isinstance(who, str) and who.strip() and who != assignee else None


def approvals_waiting():
    f = f"{H}/.hermes/approval-queue.jsonl"
    req, done = {}, set()
    for line in open(f) if os.path.exists(f) else []:
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if e.get("event") == "request":
            req[e["id"]] = e
        elif e.get("event") == "resolved":
            done.add(e.get("id"))
    return [e for i, e in req.items() if i not in done]


def unanswered(headings, open_md):
    """Decision headings whose issue is still marked asked/blocked in open.md (answered or fixed ones drop out)."""
    open_md = re.split(r"^## (?:Resolved|Known)", open_md, flags=re.M)[0]  # closed rows keep their old "asked" text
    waiting = {m.group(1) for m in re.finditer(r"^\| ([0-9a-f]{6}) \|.*\[\w+: (?:asked|blocked)\]", open_md, re.M)}
    return [h for h in headings if waiting & set(re.findall(r"\b[0-9a-f]{6}\b", h))]


def open_decisions():
    out = []
    issues = f"{H}/agents/issues/open.md"
    open_md = open(issues, encoding="utf-8").read() if os.path.exists(issues) else ""
    for f in [f"{H}/agents/issues/decisions.md"] + load("config.json", {}).get("decision_files", []):
        f = os.path.expanduser(f)
        if os.path.exists(f):
            out += unanswered([l[3:].strip() for l in open(f, encoding="utf-8") if l.startswith("## ")], open_md)
    return out


def review_items(lines, pattern):
    """List items still to decide. An APPROVED line settles its batch (items above or right below it);
    only items under a heading added after the last APPROVED line count."""
    ok = [i for i, l in enumerate(lines) if l.startswith("APPROVED")]
    if ok:
        new = [i for i, l in enumerate(lines) if i > ok[-1] and l.startswith("#")]
        lines = lines[new[0]:] if new else []
    return sum(1 for l in lines if re.match(pattern, l))


def waiting_events(sent):
    out = []
    for t in kanban_waiting():
        if t["since"] and NOW.timestamp() - t["since"] > 86400 and f"kanban:{t['id']}:{t['since']}" not in sent:
            hours = int((NOW.timestamp() - t["since"]) // 3600)
            out.append((f"kanban:{t['id']}:{t['since']}", f"⏳ Waiting on a person for {hours} h: {t.get('who') or 'unassigned'} blocked `{t['id']}` {clip(t['title'], 160)}. "
                        f"Why: {clip(t['reason'], 700) or 'see the card'}. Full card: `hermes kanban show {t['id']}`. "
                        f"Next: answer in the card's thread or unblock it on the board."))
    for e in approvals_waiting():
        at = e.get("at") or e.get("ts") or 0
        if at and NOW.timestamp() - float(at) > 86400 and f"approval:{e['id']}" not in sent:
            out.append((f"approval:{e['id']}", f"⏳ An approval from {e.get('profile', 'an agent')} has waited {int((NOW.timestamp() - float(at)) // 3600)} h. "
                        f"Next: answer it in that chat (/approve or /deny)."))
    return out


# ---------- follow-ups ----------
def followup_events(sent):
    out = []
    for f in load("followups.json", []):
        due = parse_date(f["due"])
        if f.get("closed") or not due or due > TODAY or f"followup:{f['id']}" in sent:
            continue
        out.append((f"followup:{f['id']}", f"🔁 Follow-up due ({due}): {f['text']} (set by {f.get('by', '?')}, id {f['id']}). "
                    f"Next: check it, then `follow-up close {f['id']}`."))
    return out


# ---------- CI ----------
def repos():
    for g in glob.glob(f"{H}/work/*/.git") + glob.glob(f"{H}/work/*/*/.git"):
        d = os.path.dirname(g)
        rc, url = run(["git", "-C", d, "remote", "get-url", "origin"])
        if "github.com" in url:
            yield d, re.sub(r"^(https://github\.com/|git@github\.com:)|\.git$", "", url.strip())


CI_FAILED = ("failure", "timed_out", "startup_failure")


def ci_new_failures(runs, last, done):
    """Completed runs not seen before, and which of them failed.
    Tracks completed run IDs (not only the newest ID), so a slow run that fails after a newer quick run
    completed is still reported (issue 60ca3e). `done` is None for a repo still on the old watermark
    state: then only IDs above `last` count as new, once."""
    new, failed = [], []
    for r in sorted(runs, key=lambda r: r["databaseId"]):
        i = r["databaseId"]
        if r.get("status") != "completed":
            continue
        if (i in done) if done is not None else (i <= last):
            continue
        new.append(i)
        if r.get("conclusion") in CI_FAILED:
            failed.append(r)
    return new, failed


def ci_events(state):
    out, seen = [], state.setdefault("ci_seen", {})
    done_map = state.setdefault("ci_done", {})
    gh = f"{H}/.local/bin/gh"
    if not os.path.exists(gh):
        return out
    for d, slug in repos():
        rc, head = run(["git", "-C", d, "symbolic-ref", "--short", "refs/remotes/origin/HEAD"])
        branch = head.strip().split("/", 1)[-1] or "main"
        rc, js = run([gh, "run", "list", "-R", slug, "-b", branch, "-L", "50", "--json",
                      "databaseId,conclusion,status,workflowName,url,displayTitle"], cwd=d)
        if rc:
            continue
        runs = json.loads(js or "[]")
        first = slug not in seen and slug not in done_map
        last = seen.get(slug, 0)
        done = set(done_map[slug]) if slug in done_map else None
        new, failed = ci_new_failures(runs, last, done)
        if not first:
            for r in failed:
                out.append((f"ci:{r['databaseId']}", f"❌ CI failed on {slug} `{branch}`: {r['workflowName']} ({r['displayTitle'][:60]}). Next: open {r['url']}"))
        done_map[slug] = sorted((done or set()) | set(new) | {r["databaseId"] for r in runs if r.get("status") == "completed"})[-300:]
        seen[slug] = max([last] + new)
    return out


# ---------- PR approval -> resume ----------
PR_URL = re.compile(r"https://github\.com/([\w.-]+/[\w.-]+)/pull/(\d+)")
PR_NUM = re.compile(r"\bPR #(\d+)\b")
PR_SLUG = re.compile(r"(?<![\w/.-])([\w.-]+/[\w.-]+)#(\d+)\b")   # "owner/repo#N" in a reason, for another repo
APPROVE_WORDS = re.compile(r"^\s*(approved?|lgtm|looks good|ship it)\b", re.I)


def pr_refs(text, reason, repo):
    """PRs a waiting card names: full PR URLs anywhere, plus "PR #N" in its park/block reason when config sets
    default_repo. Agents write "PR #N": a PR URL in the assignee's own comment makes Hermes hold the card for 24 h."""
    refs = set(PR_URL.findall(text)) | set(PR_SLUG.findall(reason or ""))
    if repo:
        refs |= {(repo, n) for n in PR_NUM.findall(reason or "")}
    return sorted(refs)


def pr_approved(slug, num, since, owner):
    """(approved, why) for one PR, via the gh wrapper (it picks the repo's sealed token from -R)."""
    rc, js = run([f"{H}/.local/bin/gh", "pr", "view", str(num), "-R", slug, "--json",
                  "state,reviewDecision,labels,comments,mergedAt,reviews,headRefOid"], timeout=60)
    if rc:
        return False, "unreadable"
    try:
        d = json.loads(js or "{}")
        # gh pr view's aggregate approval can survive a push. Fetch every review,
        # including its commit binding; a failed/incomplete read grants nothing.
        if d.get("state") == "OPEN":
            rc, reviews = run([f"{H}/.local/bin/gh", "api", "--paginate", "--slurp",
                              f"repos/{slug}/pulls/{num}/reviews?per_page=100"], timeout=60)
            if rc:
                return False, "reviews unreadable"
            pages = json.loads(reviews)
            if not isinstance(pages, list) or not all(isinstance(p, list) for p in pages):
                return False, "reviews unreadable"
            d["reviews"] = [{"id": r.get("id"), "author": {"login": (r.get("user") or {}).get("login"),
                                          "__typename": (r.get("user") or {}).get("type")},
                             "state": r.get("state"), "submittedAt": r.get("submitted_at"),
                             "body": r.get("body"), "commit": {"oid": r.get("commit_id")}}
                            for page in pages for r in page]
        cfg = load("config.json", {})
        ok, why = pr_verdict(d, since, owner, cfg.get("agent_github_logins", []), cfg.get("owner_gate_labels", ["human-signoff"]))
        if ok is True and d.get("state") == "OPEN":
            rc, current = run([f"{H}/.local/bin/gh", "pr", "view", str(num), "-R", slug,
                               "--json", "headRefOid,state"], timeout=60)
            current = json.loads(current or "{}")
            if rc or current.get("state") != "OPEN" or current.get("headRefOid") != d.get("headRefOid"):
                return False, "candidate changed during approval read"
    except (ValueError, TypeError, AttributeError):
        return False, "approval unreadable"
    # the head makes the reason unique per approved revision, so pr_resume can resume once per revision
    # qa-passed changes the reason too, so a card parked in Scheduled until QA passes wakes once more for it
    qa = " qa-passed" if any((l.get("name") or "").lower() == "qa-passed" for l in d.get("labels") or []) else ""
    if ok is True and why == "approved in review":
        # Old false wakes consumed a head/QA-only reason. Evidence-bearing keys
        # let a later genuine approval wake once without rewriting saved state.
        ids = sorted(str(r["id"]) for r in d.get("reviews") or [] if r.get("id")
                     and r.get("state") == "APPROVED" and (r.get("commit") or {}).get("oid") == d.get("headRefOid"))
        why += " review-event:" + (",".join(ids) or "exact-head-verified")
    return ok, f"{why} at {d['headRefOid'][:7]}{qa}" if ok is True and d.get("headRefOid") else why


def pr_verdict(d, since, owner, agents=(), gate_labels=("human-signoff",)):
    """(True, why) approved/merged; ("changes", why) a reviewer asked for changes or a person commented after the
    card was blocked; (None, "closed unmerged") for a PR closed without merging (superseded: ignored); (False, "waiting")
    otherwise. agents: the agents' own GitHub logins (their comments don't count). gate_labels (config
    owner_gate_labels): labels that mean a person must approve, so QA's qa-passed label alone doesn't release the PR."""
    if d.get("state") == "CLOSED" and not d.get("mergedAt"):
        return None, "closed unmerged"
    after = dt.datetime.fromtimestamp(since, dt.timezone.utc).isoformat() if since else ""
    if d.get("state") == "MERGED":
        # a merge from before the card waited is history the card mentions, not what it waits on
        return (True, "merged") if (d.get("mergedAt") or "") >= after else (None, "merged before the card waited")
    qa_passed = any((l.get("name") or "").lower() == "qa-passed" for l in d.get("labels") or [])
    names = {(l.get("name") or "").lower() for l in d.get("labels") or []}
    human_gate = bool(names & {g.lower() for g in gate_labels})
    bots = {a.lower() for a in agents}
    head = d.get("headRefOid") or ""
    latest = {}
    for r in sorted(d.get("reviews") or [], key=lambda r: r.get("submittedAt") or ""):
        author = r.get("author") or {}
        who = (author.get("login") or "").lower()
        if not who or who in bots or who.endswith("[bot]") or author.get("__typename") != "User":
            continue
        if r.get("state") in ("APPROVED", "CHANGES_REQUESTED", "DISMISSED"):
            latest[who] = r
    if d.get("reviewDecision") == "APPROVED" and re.fullmatch(r"[0-9a-fA-F]{40}", head) and any(
            r.get("state") == "APPROVED" and (r.get("commit") or {}).get("oid") == head
            and (qa_passed or (r.get("submittedAt") or "") >= after) for r in latest.values()):
        # A repark does not invalidate approval of the SAME head. QA and an
        # aggregate decision can never bind an older review to a new candidate.
        return True, "approved in review"
    if not human_gate and names & {"approved", "owner-approved"}:
        return True, "labelled approved"
    if qa_passed and not names & {g.lower() for g in gate_labels}:
        # QA's pass label is the merge release for a PR that needs no person's sign-off (no review approval is given there)
        return True, "qa passed"
    after = dt.datetime.fromtimestamp(since, dt.timezone.utc).isoformat() if since else ""
    bots = {a.lower() for a in agents}
    for c in (d.get("comments") or []) + ([] if human_gate else (d.get("reviews") or [])):
        who = ((c.get("author") or {}).get("login") or "").lower()
        when = c.get("createdAt") or c.get("submittedAt") or ""
        # no github_owner set: any human (not an agent login) may approve
        approver = who == owner.lower() if owner else bool(who) and who not in bots
        approver = approver and who not in bots and not who.endswith("[bot]") and (c.get("author") or {}).get("__typename") != "Bot"
        # Labels and an unqualified 'approved' cannot attest an exact-head human
        # gate. Keep ordinary comment feedback, but require the complete SHA
        # for comment-based sign-off on a human-gated PR.
        bound = not human_gate or (bool(re.fullmatch(r"[0-9a-fA-F]{40}", head)) and
                                   re.search(r"(?<![0-9a-fA-F])" + re.escape(head) + r"(?![0-9a-fA-F])", c.get("body") or ""))
        if approver and bound and when >= after and APPROVE_WORDS.match(c.get("body") or ""):
            return True, f"approved in a comment by {who}"
    for c in d.get("reviews") or []:
        who = ((c.get("author") or {}).get("login") or "").lower()
        if (c.get("submittedAt") or "") >= after and c.get("state") == "CHANGES_REQUESTED" and who not in bots:
            return "changes", f"changes requested by {who}"
    if bots:
        for c in (d.get("comments") or []) + (d.get("reviews") or []):
            who = ((c.get("author") or {}).get("login") or "").lower()
            when = c.get("createdAt") or c.get("submittedAt") or ""
            if who and who not in bots and when >= after and (c.get("body") or "").strip():
                return "changes", f"review comment by {who}"
    return False, "waiting"


def pr_resume():
    db = f"{H}/.hermes/kanban.db"
    if not os.path.exists(db):
        return
    owner = load("config.json", {}).get("github_owner", "")
    state = load("state.json", {})
    done = state.setdefault("pr_resumed", {})
    # an approval is timeless: without this, every re-block of the same card resumes it again (block loop)
    used = state.setdefault("pr_resumed_why", {})
    c = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=10)
    for t in kanban_waiting():
        if done.get(t["id"]) == t["since"] or (t["reason"] or "").startswith("FOCUS HOLD"):  # parked on purpose
            continue
        body = (c.execute("select coalesce(body,'') from tasks where id=?", (t["id"],)).fetchone() or [""])[0]
        comments = " ".join(b for b, in c.execute("select body from task_comments where task_id=? order by created_at desc limit 5", (t["id"],)))
        prs = pr_refs(" ".join([t["title"] or "", body, t["reason"] or "", comments]), t["reason"],
                      load("config.json", {}).get("default_repo", ""))
        if not prs:
            continue
        results = [(slug, num, *pr_approved(slug, num, t["since"], owner)) for slug, num in prs]
        results = [r for r in results if r[2] is not None]  # superseded PRs don't count
        if not results:
            continue
        fb = [(slug, num, w) for slug, num, ok, w in results if ok == "changes"]
        approved = not fb and all(ok is True for *_, ok, _ in results)
        why = "; ".join(f"{slug}#{num} {w}" for slug, num, *_, w in (fb or results))
        if not (fb or approved):
            continue
        if approved and used.get(t["id"]) == why:
            done[t["id"]] = t["since"]
            continue
        who = implementer(c, t["id"], t["who"])
        if who:   # supported handoff first, so the card resumes with the role that can act on the PR
            rc, out = run([f"{H}/.local/bin/hermes", "kanban", "reassign", t["id"], who])
            if rc:
                print(f"⚠️ {t['id']}: PR {why}, but handing it back to {who} failed: {clip(out, 200)}")
                continue
            t = dict(t, who=who)
        if fb:
            rc, out = resume_card(t, f"Review feedback: {why}. Read the PR review and comments, address them on this "
                                     f"card, then block it again with the PR URL to wait for approval.")
            if rc == 0:
                done[t["id"]] = t["since"]
                print(f"💬 {t['id']} ({t['who']}) resumed for review feedback: {why}")
            continue
        rc, out = resume_card(t, f"Resumed automatically: {why}. Carry on with the approved work.")
        if rc == 0:
            done[t["id"]] = t["since"]
            used[t["id"]] = why
            print(f"🔓 {t['id']} ({t['who']}) resumed: {why}")
    save("state.json", state)


