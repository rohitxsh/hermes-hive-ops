def check():
    state = load("state.json", {})
    sent = state.setdefault("sent", {})
    events = []
    for fn in (renewal_events, waiting_events, followup_events):
        try:
            events += fn(sent)
        except Exception as e:  # one broken source must not hide the others
            events.append((f"error:{fn.__name__}:{TODAY}", f"⚠️ attention: {fn.__name__} failed: {type(e).__name__}: {e}"))
    try:
        events += ci_events(state)
    except Exception as e:
        events.append((f"error:ci:{TODAY}", f"⚠️ attention: CI check failed: {type(e).__name__}: {e}"))
    events = [(k, m) for k, m in events if k not in sent]
    if "--dry-run" in sys.argv:  # preview: nothing is marked sent, CI baselines aren't stored
        print("\n".join(m for _, m in events) or "(nothing new)")
        return
    for k, _ in events:
        sent[k] = str(NOW)
    cutoff = (NOW - dt.timedelta(days=120)).isoformat()
    state["sent"] = {k: v for k, v in sent.items() if v >= cutoff}
    save("state.json", state)
    if events:
        print("\n".join(m for _, m in events[:5]) + (f"\n…and {len(events) - 5} more: run `waiting-on-me`." if len(events) > 5 else ""))


def waiting():
    lines = []
    for t in kanban_waiting():
        age = f"{int((NOW.timestamp() - t['since']) // 3600)} h" if t["since"] else "?"
        lines.append(f"- Kanban `{t['id']}` ({t.get('who') or 'unassigned'}, {age}): {clip(t['title'], 160)}. Why: {clip(t['reason'], 700) or 'see the card'}")
    for e in approvals_waiting():
        lines.append(f"- Approval from {e.get('profile', '?')}: {clip(e.get('prompt') or e.get('kind') or '', 400)}")
    for d in open_decisions():
        lines.append(f"- Decision: {d[:140]}")
    for f in load("followups.json", []):
        if not f.get("closed"):
            lines.append(f"- Follow-up {f['id']} due {f['due']}: {f['text'][:120]}")
    for x in load("config.json", {}).get("review_lists", []):
        p = os.path.expanduser(x["path"])
        if os.path.exists(p):
            n = review_items(open(p, encoding="utf-8").read().splitlines(), x.get("pattern", r"^\s*[-*\d]"))
            if n:
                lines.append(f"- {x['label']}: {n} item(s) in {x['path']}")
    print("\n".join(lines) if lines else "Nothing is waiting on you.")


def followup(args):
    fs = load("followups.json", [])
    if not args or args[0] == "list":
        for f in fs:
            print(f"{f['id']}  due {f['due']}  {'closed' if f.get('closed') else 'open'}  {f['text']}")
        return
    if args[0] == "add":
        due, by, text, i = None, os.environ.get("HERMES_PROFILE", "?"), [], 1
        while i < len(args):
            if args[i] == "--due":
                due, i = args[i + 1], i + 2
            elif args[i] == "--by":
                by, i = args[i + 1], i + 2
            else:
                text.append(args[i])
                i += 1
        assert due and parse_date(due) and text, "usage: follow-up add --due YYYY-MM-DD [--by PROFILE] TEXT"
        fid = f"f{len(fs) + 1}"
        fs.append({"id": fid, "due": str(parse_date(due)), "by": by, "text": " ".join(text), "created": str(NOW)})
        save("followups.json", fs)
        print(f"added {fid} (due {parse_date(due)})")
    elif args[0] == "close":
        for f in fs:
            if f["id"] == args[1]:
                f.update(closed=str(NOW), note=" ".join(args[2:]))
        save("followups.json", fs)
        print("closed", args[1])


def renewal_cmd(args):
    rs = load("renewals.json", [])
    if not args or args[0] == "list":
        for r in sorted(renewals(), key=lambda r: str(r["date"])):
            print(f"{r['date']}  {r['name']}  {r.get('note', '')}")
        return
    if args[0] == "add":
        date = args[args.index("--date") + 1]
        note = args[args.index("--note") + 1] if "--note" in args else ""
        name = " ".join(a for i, a in enumerate(args[1:], 1) if a not in ("--date", "--note") and args[i - 1] not in ("--date", "--note"))
        assert parse_date(date) and name, "usage: renewals add --date YYYY-MM-DD NAME [--note TEXT]"
        rs = [r for r in rs if r["name"] != name] + [{"name": name, "date": str(parse_date(date)), "note": note}]
    elif args[0] == "remove":
        rs = [r for r in rs if r["name"] != " ".join(args[1:])]
    save("renewals.json", rs)
    print("ok")


def selftest():
