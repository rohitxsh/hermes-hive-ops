    assert any(r["name"] == "plan" and r["date"] == "2026-12-01" for r in renewals()), load("auto-cache.json", {})
    save("config.json", {})
    save("followups.json", [{"id": "f1", "due": str(TODAY), "text": "t"}, {"id": "f2", "due": str(TODAY + dt.timedelta(days=3)), "text": "u"}])
    fe = followup_events({})
    assert [k for k, _ in fe] == ["followup:f1"], fe
    assert clip("one two three four", 12) == "one two…" and clip("short", 10) == "short" and len(clip("x" * 50, 20)) == 20
    assert PR_URL.findall("see https://github.com/a/b/pull/3 and PR #4") == [("a/b", "3")]
    assert APPROVE_WORDS.match("Approved, go ahead") and APPROVE_WORDS.match("LGTM") and not APPROVE_WORDS.match("not approved")
    # pr-resume: dev asks for review, QA passes and parks the card, a person approves -> back to dev, then resumed;
    # a FOCUS HOLD card with an approved PR stays parked
    h0, H = H, tempfile.mkdtemp(dir=D)
    os.makedirs(f"{H}/.hermes")
    kc = sqlite3.connect(f"{H}/.hermes/kanban.db")
    kc.executescript("create table task_events(id integer primary key, task_id, kind, payload, created_at);"
                     "create table tasks(id, body); create table task_comments(task_id, body, created_at);"
                     "insert into tasks values ('t_1', 'Development merges after QA and human approval'), ('t_2', '');")
    kc.execute("insert into task_events(task_id, kind, payload, created_at) values ('t_1', 'review_requested', ?, 1)",
               (json.dumps({"implementer": "team-dev", "reviewer": "team-qa"}),))
    kc.commit()
    assert implementer(kc, "t_1", "team-dev") is None and implementer(kc, "t_2", "team-qa") is None
    calls, g = [], globals()
    saved = {k: g[k] for k in ("kanban_waiting", "pr_approved", "run", "resume_card")}
    g["kanban_waiting"] = lambda: [
        {"id": "t_1", "who": "team-qa", "title": "x", "since": 5, "reason": "waiting on https://github.com/o/r/pull/7", "status": "scheduled"},
        {"id": "t_2", "who": "team-dev", "title": "y", "since": 5, "reason": "FOCUS HOLD (x) https://github.com/o/r/pull/8", "status": "scheduled"}]
    g["pr_approved"] = lambda slug, num, since, owner: (True, "approved in review")
    g["run"] = lambda cmd, **k: (calls.append(cmd[1:]), (0, ""))[1]
    g["resume_card"] = lambda t, reason: (calls.append(("resume", t["id"], t["who"])), (0, ""))[1]
    try:
        pr_resume()
    finally:
        g.update(saved)
        H = h0
    assert calls == [["kanban", "reassign", "t_1", "team-dev"], ("resume", "t_1", "team-dev")], calls
    print("selftest ok")


