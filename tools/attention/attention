    assert pr_refs("", "waiting on someone/tools#12 review", "o/r") == [("someone/tools", "12")]
    assert pr_refs("", "see https://x.io/a/b#3", "") == []
    # CI (issue 60ca3e): a slow run that fails after a newer quick run completed must still be reported
    slow = {"databaseId": 10, "status": "in_progress", "conclusion": ""}
    quick = {"databaseId": 11, "status": "completed", "conclusion": "success"}
    new, failed = ci_new_failures([slow, quick], 9, {9})
