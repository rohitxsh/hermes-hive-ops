#!/usr/bin/python3
"""kanban-doctor (2026-11-04): find Kanban cards that look stuck, for the admin assistant's repair job. No model calls.

  kanban-doctor                      stable list of stuck-looking cards (monitor-script output: no ages or timestamps,
                                     so the agent runs only when the set or a reason changes)
  kanban-doctor release ID REASON [--to PROFILE]
                                     release a held triage card or a blocked one (posts REASON as a comment first;
                                     triage uses the same call as pr-resume, blocked uses `hermes kanban unblock`). Released cards go back to the lane they came from; with --to, a card
                                     that lands in review is reopened and handed to PROFILE as a normal run (a QA card
                                     going back to its developer), and any other card is reassigned to PROFILE
  kanban-doctor --selftest

A card is listed when it is: blocked for >30 min on anything but another card (needs_input blocks are left out: those
wait on a person); held in triage after a block loop (kind other than needs_input); ready or in review but not picked up for >45 min;
running with no heartbeat for >30 min; scheduled for >24 h; todo for >12 h although every parent is done; or flagged by
`hermes kanban diagnostics` at error level; and, once a day, cards that have waited on a person (needs_input) for over
a day, so the agent re-checks whether the question was answered or became unnecessary. An unassigned card shows who
created it. Whether a listed card really waits on a person is the agent's call.
"""
import glob
import json
import os
import sqlite3
import subprocess
import sys
import time

H = os.path.expanduser("~")
DB = f"{H}/.hermes/kanban.db"
LOOP_HELD = """(select e.kind from task_events e where e.task_id = t.id and e.kind in
    ('block_loop_detected', 'promoted', 'specified', 'decomposed', 'created') order by e.created_at desc, e.id desc limit 1)
    = 'block_loop_detected'"""


def pm_author():
    """PM comment author: environment override, local config, then generic pm.

    Set ~/agents/kanban-doctor/config.json's pm_author to the deployment's
    orchestrator profile. DOCTOR_PM_AUTHOR overrides it for a single run.
    Invalid configuration is an error, never a fallback to another author.
    """
    author = os.environ.get('DOCTOR_PM_AUTHOR')
    if author is None:
        try:
            with open(f"{H}/agents/kanban-doctor/config.json") as f:
                config = json.load(f)
        except FileNotFoundError:
            config = {}
        if not isinstance(config, dict):
            raise ValueError('kanban-doctor config must be an object')
        author = config.get('pm_author', 'pm')
    if not isinstance(author, str) or not author.strip():
        raise ValueError('kanban-doctor pm_author must be a nonempty profile name')
    return author


def candidates(db, now, diags=()):
    author = pm_author()
    c = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=10)
    # respawn_guarded fires every tick while a card is held, so it must not count as activity
    last = "(select max(created_at) from task_events e where e.task_id = t.id and e.kind != 'respawn_guarded'{})"
    rows = c.execute(f"""select t.id, t.status, coalesce(t.block_kind, ''), coalesce(t.assignee, ''), t.title, coalesce(t.created_by, ''),
        {last.format("")}, {last.format(" and e.kind = 'heartbeat'")},
        (select payload from task_events e where e.task_id = t.id and e.kind in ('blocked', 'block_loop_detected', 'scheduled')
         order by created_at desc limit 1),
        (t.status = 'triage' and {LOOP_HELD}),
        (select count(*) from task_links l join tasks p on p.id = l.parent_id where l.child_id = t.id
         and p.status not in ('done', 'archived'))
        from tasks t where t.status in ('blocked', 'triage', 'ready', 'review', 'running', 'scheduled', 'todo')""").fetchall()
    # These comments only make a possible repair visible; they never authorize release.
    repair_requests = set()
    refresh_followups = set()
    if c.execute("select 1 from sqlite_master where type='table' and name='task_comments'").fetchone():
        for tid, body, block_kind in c.execute("""select t.id, m.body, t.block_kind from tasks t
            join task_comments m on m.id = (select m2.id from task_comments m2
                where m2.task_id=t.id and m2.author=?
                order by m2.created_at desc, m2.id desc limit 1)
            where t.status='triage' and t.block_kind in ('needs_input', 'capability')
              and m.created_at > coalesce((select max(e.created_at) from task_events e
                where e.task_id=t.id and e.kind in ('blocked','block_loop_detected','scheduled')), 0)""", (author,)):
            if (block_kind == 'needs_input' and 'Supported lifecycle-owner recovery requested' in (body or '')
                    and 'This is an admin prerequisite, not a new team approval request.' in (body or '')):
                repair_requests.add(tid)
            if (block_kind == 'capability'
                    and 'PM verified the previously pending runtime refresh completed' in (body or '')
                    and 'the existing doctor must now qualify the retained reviewer continuation.' in (body or '')):
                refresh_followups.add(tid)
    c.close()
    out = []
    for tid, status, kind, who, title, creator, last_ev, last_hb, payload, loop_held, open_parents in rows:
        age = 0 if last_ev is None else (now - last_ev) / 60
        try:
            reason = (json.loads(payload or "{}") or {}).get("reason", "") if status in ("blocked", "triage", "scheduled") else ""
        except ValueError:
            reason = ""
        why = None
        if status == "triage" and loop_held and tid in refresh_followups:
            why = "runtime-refresh-followup"
            reason = "Newer PM reports refresh complete; doctor must independently verify activation, gates and retained review provenance. Detection only, not release authority."
        elif status == "triage" and loop_held and tid in repair_requests:
            why = "lifecycle-repair-request"
            reason = "Newer explicit PM lifecycle-owner request; verify current human gates before any recovery."
        elif status == "scheduled" and reason.startswith("Implementation admission pending lifecycle repair, NOT human approval."):
            why = "lifecycle-repair-request"
        elif status == "blocked" and kind not in ("dependency", "needs_input") and age > 30:
            # a transient (quota) block can clear by itself: the hour count changes the output so the job looks again
            why = f"blocked {int(age // 60)}h" if kind == "transient" else "blocked"
        elif status == "triage" and loop_held and kind != "needs_input":
            why = "loop-held"
        elif status in ("blocked", "triage") and kind == "needs_input" and age > 24 * 60:
            # the day count changes the output once a day, so the job re-checks whether the question still stands
            why = f"waiting-on-person {int(age // (24 * 60))}d"
        elif status in ("ready", "review") and age > 45:
            why = "not-picked-up"
        elif status == "running" and age > 30:  # last_ev includes heartbeats; an older run's heartbeat must not count
            why = "no-heartbeat"
        elif status == "scheduled" and age > 24 * 60:
            why = "parked-24h"
        elif status == "todo" and open_parents == 0 and age > 12 * 60:
            why = "todo-parents-done"
        if tid in diags:
            why = (why + "+" if why else "") + "diagnostic:" + diags[tid]
        if not why:
            continue
        who = who if who and who != "unassigned" else f"unassigned(created by {creator or '?'})"
        out.append(f"{tid} {status} kind={kind or '-'} @{who} [{why}] {title[:80]} | {' '.join(reason.split())[:220]}")
    return sorted(out)


def confirmed_clean_schedule(db, tid):
    """Only clear a stale crash signal with durable same-run clean parking proof.

    Scheduled parking, native dependency_wait (TODO, or READY after parent
    completion), and an unclaimed capability block require a terminal error-free
    run and its later integer-zero worker_result. Upstream repeated_crashes scans
    across these outcomes. Capability holds remain unchanged and age-visible.
    Do not change upstream code/history or infer acceptance, capacity release or
    permission to resume. Missing/ambiguous proof keeps the signal visible.
    """
    c = None
    try:
        c = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=10)
        c.execute("PRAGMA query_only=ON")
        c.execute("BEGIN")
        row = c.execute("""select r.id, r.ended_at, t.status, r.status, r.outcome
            from task_runs r join tasks t on t.id=r.task_id
            where t.id=? and r.id=(select r2.id from task_runs r2
                where r2.task_id=t.id order by r2.started_at desc,r2.id desc limit 1)
              and r.ended_at is not null and r.error is null""", (tid,)).fetchone()
        if not row:
            return False
        rid, ended, task_status, run_status, outcome = row
        if task_status == run_status == outcome == 'scheduled':
            event_kind = 'scheduled'
        elif task_status in ('todo', 'ready') and run_status == outcome == 'blocked':
            # Native dependency_wait parks as TODO/blocked; parent completion can
            # promote it to READY. Neither transition is a worker crash.
            if not c.execute("""select 1 from tasks t where t.id=?
                and t.block_kind='dependency' and t.current_run_id is null
                and exists(select 1 from task_links l where l.child_id=t.id)""", (tid,)).fetchone():
                return False
            event_kind = 'dependency_wait'
        elif task_status == run_status == outcome == 'blocked':
            # A clean capability stop is not a crash and grants no release authority.
            if not c.execute("""select 1 from tasks where id=? and block_kind='capability'
                and current_run_id is null and claim_lock is null and worker_pid is null""", (tid,)).fetchone():
                return False
            latest_block = c.execute("""select run_id from task_events where task_id=?
                and kind='blocked' order by created_at desc,id desc limit 1""", (tid,)).fetchone()
            if not latest_block or latest_block[0] != rid:
                return False
            event_kind = 'blocked'
        else:
            return False
        parked = c.execute("""select created_at,payload from task_events where task_id=? and run_id=?
            and kind=? order by created_at desc,id desc limit 1""", (tid, rid, event_kind)).fetchone()
        if event_kind == 'blocked':
            data = json.loads(parked[1]) if parked else None
            if (not isinstance(data, dict) or data.get('kind') != 'capability'
                    or data.get('source_status') not in ('ready', 'review')):
                return False
        if event_kind == 'dependency_wait':
            data = json.loads(parked[1]) if parked else None
            if (not isinstance(data, dict) or data.get('kind') != 'dependency'
                    or data.get('source_status') not in ('ready', 'review')):
                return False
        result = c.execute("""select created_at,payload from task_events where task_id=? and run_id=?
            and kind='worker_result' order by created_at desc,id desc limit 1""", (tid, rid)).fetchone()
        if not parked or not result or not parked[0] <= ended <= result[0]:
            return False
        payload = json.loads(result[1])
        return isinstance(payload, dict) and type(payload.get('exit_code')) is int and payload['exit_code'] == 0
    except (sqlite3.Error, OSError, ValueError, TypeError):
        return False
    finally:
        if c is not None:
            c.close()


def diagnostics():
    try:
        r = subprocess.run([f"{H}/.local/bin/hermes", "kanban", "diagnostics", "--json", "--severity", "error"],
                           capture_output=True, text=True, timeout=120)
        out = {}
        for d in json.loads(r.stdout or "[]"):
            tid = d["task_id"]
            kinds = {x["kind"] for x in d.get("diagnostics", [])}
            if 'repeated_crashes' in kinds and confirmed_clean_schedule(DB, tid):
                kinds.remove('repeated_crashes')
                if not kinds:
                    continue
            out[tid] = ','.join(sorted(kinds))
        return out
    except (OSError, subprocess.TimeoutExpired, ValueError, KeyError, TypeError):
        return {}


def status_of(tid):
    c = sqlite3.connect(f"file:{DB}?mode=ro", uri=True, timeout=10)
    row = c.execute("select status, coalesce(assignee, '') from tasks where id = ?", (tid,)).fetchone()
    c.close()
    return row or ("", "")


def after_release(status, assignee, to):
    """The hermes kanban calls that put a released card with `to` as a normal run: [] when nothing is needed."""
    if not to:
        return []
    if status == "review":   # back in the review lane: an implementer started there gets a review-only run
        return [["reopen-review"], ["assign", to]]
    return [["assign", to]] if assignee != to else []


def release(tid, reason, to=None):
    hermes = f"{H}/.local/bin/hermes"
    if subprocess.run([hermes, "kanban", "comment", tid, reason], capture_output=True).returncode:
        sys.exit(f"kanban-doctor: could not comment on {tid}")
    f = sorted(glob.glob(f"{H}/.hermes/installs/*/facts.json"), key=os.path.getmtime)[-1]
    py = json.load(open(f))["packages"]["venv"]["environment"] + "/bin/python"
    code = ("import sys; from hermes_cli import kanban_db as kb, kanban_db_connect as kbc\n"
            "with kbc.connect_closing() as c: sys.exit(0 if kb.specify_triage_task(c, sys.argv[1]) else 1)")
    if status_of(tid)[0] == "blocked":   # a block waiting on a question that no longer needs a person
        rc = subprocess.run([hermes, "kanban", "unblock", tid], capture_output=True).returncode
    else:
        rc = subprocess.run([py, "-I", "-c", code, tid]).returncode
    if rc:
        sys.exit(f"kanban-doctor: {tid} is not a releasable triage or blocked card")
    for step in after_release(*status_of(tid), to):
        args = [hermes, "kanban", step[0], tid] + step[1:]
        if subprocess.run(args, capture_output=True).returncode:
            sys.exit(f"kanban-doctor: released {tid}, but `{' '.join(args[1:])}` failed: fix it by hand")
    print(f"released {tid}" + (f" to {to} ({' '.join(status_of(tid))})" if to else ""))


def selftest():
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        db = f"{d}/k.db"
        c = sqlite3.connect(db)
        c.executescript("""create table tasks (id, status, assignee, title, block_kind, created_by);
            create table task_events (id integer primary key, task_id, kind, created_at, payload);
            create table task_links (parent_id, child_id);
            insert into tasks (id, status, assignee, title, block_kind) values ('a', 'blocked', 'dev', 'tool gap', 'capability'), ('b', 'blocked', 'pm', 'ask', 'needs_input'),
              ('c', 'triage', 'dev', 'looped', 'transient'), ('d', 'ready', 'qa', 'idle', null), ('e', 'running', 'dev', 'busy', null),
              ('f', 'todo', 'dev', 'parents done', null), ('g', 'todo', 'dev', 'parent open', null), ('p', 'done', 'x', 'p', null),
              ('r', 'review', 'dev', 'held rework', null),
              ('q', 'running', 'x', 'q', null), ('h', 'blocked', 'dev', 'fresh', 'capability');
            insert into tasks values ('u', 'ready', 'unassigned', 'no owner', null, 'research');
            insert into task_events (task_id, kind, created_at, payload) values
              ('a', 'blocked', 0, '{"reason": "no unlink tool"}'), ('b', 'blocked', 0, '{"reason": "approve?"}'),
              ('c', 'block_loop_detected', 0, '{"reason": "same block"}'), ('d', 'promoted', 0, '{}'),
              ('e', 'heartbeat', 99000, '{}'), ('q', 'heartbeat', 0, '{}'), ('q', 'claimed', 99500, '{}'), ('f', 'created', 0, '{}'), ('g', 'created', 0, '{}'), ('h', 'blocked', 99000, '{}'), ('u', 'created', 0, '{}'),
              ('r', 'review_requested', 0, '{}'), ('r', 'respawn_guarded', 99900, '{}');
            insert into task_links values ('p', 'f'), ('q', 'g');""")
        c.commit(); c.close()
        got = candidates(db, 100000, {"e": "repeated_crashes"})
        ids = [x.split()[0] for x in got]
        assert ids == ["a", "b", "c", "d", "e", "f", "r", "u"], got
        assert "[waiting-on-person 1d]" in got[1] and "@unassigned(created by research) [not-picked-up]" in got[7], got
        assert "[blocked]" in got[0] and "no unlink tool" in got[0] and "[diagnostic:repeated_crashes]" in got[4]
        # Latest/newer PM comments change visibility only, never release authority.
        c = sqlite3.connect(db)
        c.execute('create table task_comments (id integer primary key, task_id, author, body, created_at)')
        for tid, kind, text, signal in [
            ('repair', 'needs_input', 'Supported lifecycle-owner recovery requested. '
             'This is an admin prerequisite, not a new team approval request.', 'lifecycle-repair-request'),
            ('refresh', 'capability', 'PM verified the previously pending runtime refresh completed; '
             'the existing doctor must now qualify the retained reviewer continuation.', 'runtime-refresh-followup'),
        ]:
            c.execute('insert into tasks values (?,?,?,?,?,?)', (tid, 'triage', 'qa', 'fixture', kind, 'dev'))
            c.execute('insert into task_events (task_id,kind,created_at,payload) values (?,?,?,?)',
                      (tid, 'block_loop_detected', 99000, '{}'))
            c.execute('insert into task_comments (task_id,author,body,created_at) values (?,?,?,?)',
                      (tid, pm_author(), text, 99900))
            c.commit()
            assert any(row.startswith(tid + ' ') and f'[{signal}]' in row
                       for row in candidates(db, 100000)), tid
            c.execute('insert into task_comments (task_id,author,body,created_at) values (?,?,?,?)',
                      (tid, pm_author(), 'Waiting for a person; do not release.', 99901))
            c.commit()
            assert not any(row.startswith(tid + ' ') and f'[{signal}]' in row
                           for row in candidates(db, 100000)), tid
        c.close()
    assert after_release("review", "qa", "dev") == [["reopen-review"], ["assign", "dev"]]
    assert after_release("ready", "qa", "dev") == [["assign", "dev"]]
    assert after_release("ready", "dev", "dev") == [] and after_release("review", "qa", None) == []
    # Keep these proofs in the standalone tool so kit installs exercise them too.
    with tempfile.TemporaryDirectory() as d:
        db = f"{d}/clean.db"
        c = sqlite3.connect(db)
        c.executescript("""create table tasks
            (id, status, block_kind, current_run_id, claim_lock, worker_pid);
            create table task_runs
            (id integer primary key, task_id, status, outcome, started_at, ended_at, error);
            create table task_events
            (id integer primary key, task_id, run_id, kind, created_at, payload);
            create table task_links (parent_id, child_id);""")
        for status, kind, event in [('scheduled', None, 'scheduled'),
                                     ('todo', 'dependency', 'dependency_wait'),
                                     ('ready', 'dependency', 'dependency_wait'),
                                     ('blocked', 'capability', 'blocked')]:
            for origin in ('ready', 'review'):
                for case in ('clean', 'nonzero', 'boolean', 'missing-result', 'wrong-run',
                             'wrong-task', 'result-too-early', 'error', 'newer-crash',
                             'active-run', 'missing-park', 'wrong-kind', 'wrong-origin',
                             'missing-parent', 'claim', 'worker', 'later-block'):
                    c.executescript('delete from tasks; delete from task_runs; '
                                    'delete from task_events; delete from task_links;')
                    terminal = 'scheduled' if status == 'scheduled' else 'blocked'
                    c.execute('insert into tasks values (?,?,?,?,?,?)',
                              ('x', status, kind, None, None, None))
                    c.execute('insert into task_links values (?,?)', ('parent', 'x'))
                    for rid in (1, 2):
                        c.execute('insert into task_runs values (?,?,?,?,?,?,?)',
                                  (rid, 'x', 'crashed', 'crashed', rid, rid + 1, 'old crash'))
                    c.execute('insert into task_runs values (?,?,?,?,?,?,?)',
                              (3, 'x', terminal, terminal, 90, 100, None))
                    c.execute('insert into task_events values (?,?,?,?,?,?)',
                              (1, 'x', 3, event, 100,
                               json.dumps({'kind': kind, 'source_status': origin})))
                    c.execute('insert into task_events values (?,?,?,?,?,?)',
                              (2, 'x', 3, 'worker_result', 101, '{"exit_code":0}'))
                    edits = {
                        'nonzero': ('update task_events set payload=? where id=2', '{"exit_code":1}'),
                        'boolean': ('update task_events set payload=? where id=2', '{"exit_code":false}'),
                        'missing-result': ('delete from task_events where id=2',),
                        'wrong-run': ('update task_events set run_id=2 where id=2',),
                        'wrong-task': ("update task_events set task_id='other' where id=2",),
                        'result-too-early': ('update task_events set created_at=99 where id=2',),
                        'error': ("update task_runs set error='failure' where id=3",),
                        'newer-crash': ("insert into task_runs values (4,'x','crashed','crashed',110,120,'new crash')",),
                        'active-run': ('update tasks set current_run_id=4',),
                        'missing-park': ('delete from task_events where id=1',),
                        'wrong-kind': ("update task_events set payload=? where id=1", json.dumps({'kind':'needs_input','source_status':origin})),
                        'wrong-origin': ("update task_events set payload=? where id=1", json.dumps({'kind':kind,'source_status':'running'})),
                        'missing-parent': ('delete from task_links',),
                        'claim': ("update tasks set claim_lock='active'",),
                        'worker': ('update tasks set worker_pid=42',),
                        'later-block': ("insert into task_events values (3,'x',null,'blocked',102,'{}')",),
                    }
                    # These guards are intentionally specific to their native park shape.
                    applies = (case not in ('active-run','wrong-kind','wrong-origin','missing-parent','claim','worker','later-block')
                               or case in ('active-run','wrong-kind','wrong-origin') and kind is not None
                               or case == 'missing-parent' and kind == 'dependency'
                               or case in ('claim','worker','later-block') and kind == 'capability')
                    if case != 'clean' and not applies:
                        continue
                    if case != 'clean':
                        sql, *params = edits[case]
                        c.execute(sql, params)
                    c.commit()
                    with open(db, 'rb') as f:
                        before = f.read()
                    assert confirmed_clean_schedule(db, 'x') == (case == 'clean'), (status, origin, case)
                    with open(db, 'rb') as f:
                        assert f.read() == before, 'clean-park monitor wrote to its database'
        c.close()
    print("selftest ok")


if __name__ == "__main__":
    a = sys.argv[1:]
    if a[:1] == ["--selftest"]:
        selftest()
    elif a[:1] == ["release"] and len(a) >= 3:
        to = a[a.index("--to") + 1] if "--to" in a and a.index("--to") + 1 < len(a) else None
        words = [w for i, w in enumerate(a[2:], 2) if w != "--to" and (i == 0 or a[i - 1] != "--to")]
        release(a[1], " ".join(words), to)
    elif not a:
        rows = candidates(DB, time.time(), diagnostics()) if os.path.exists(DB) else []
        print("\n".join(rows) if rows else "no stuck-looking cards")
    else:
        sys.exit(__doc__)
