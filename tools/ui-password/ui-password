#!/bin/bash
# Set the sign-in password of this machine's Hermes Webapp (LAN port 9120), Hermes dashboard (9119) or browser view
# (noVNC, 6080). You type the password here, twice, hidden; it is never shown, logged or put on a command line.
#   ui-password webapp [username]      username defaults to your login name
#   ui-password dashboard [username]
#   ui-password vnc
# Webapp: username + scrypt hash in ~/.hermes/config.yaml (dashboard.basic_auth); the gateway restarts when idle.
# Dashboard: its own username + hash in ~/.config/hermes-ui/dashboard.env (they override the Webapp's), then it restarts.
# VNC: sealed with systemd-creds (only the first 8 characters count in VNC), then the browser service restarts,
# which closes the agents' open browser tabs.
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
what=${1:-}; user=${2:-$USER}
PY=$(/usr/bin/python3 -c 'import json,glob,os
f=max(glob.glob(os.path.expanduser("~/.hermes/installs/*/facts.json")),key=os.path.getmtime)
print(json.load(open(f))["packages"]["venv"]["environment"]+"/bin/python")')
# prompt on the terminal, print the scrypt hash (or with --raw the password itself, for sealing) on stdout
ask() {
  (cd "$HOME/.hermes/hermes-agent" && "$PY" -c '
import getpass, sys
a = getpass.getpass(sys.argv[1] + " password (" + sys.argv[2] + "+ characters): ")
b = getpass.getpass("Same password again: ")
if a != b: sys.exit("The two entries differ; nothing changed.")
if len(a) < int(sys.argv[2]): sys.exit("Too short; nothing changed.")
if sys.argv[3] == "--raw":
    sys.stdout.write(a)
else:
    from plugins.dashboard_auth.basic import hash_password
    print(hash_password(a))' "$1" "$2" "$3")
}
log() { printf '%s  ui-password: %s\n' "$(date '+%F %H:%M')" "$1" >> "$HOME/agents/ADMIN-CHANGES.md"; }

case "$what" in
webapp)
  hash=$(ask "Webapp" 12 --hash)
  hermes config set dashboard.basic_auth.username "$user" >/dev/null
  hermes config set dashboard.basic_auth.password_hash "$hash" >/dev/null
  unset hash
  sudo -n systemd-run --unit "hermes-restart-idle-$(date +%s)" --collect "$HOME/.local/bin/hermes-restart-idle" >/dev/null
  log "Webapp sign-in set (user $user)"
  echo "Webapp password set for '$user'. The gateway restarts when no chat is running (usually within a minute);"
  echo "then open http://$(hostname -I | awk '{print $1}'):9120" ;;
dashboard)
  hash=$(ask "Dashboard" 12 --hash)
  mkdir -p "$HOME/.config/hermes-ui"; chmod 700 "$HOME/.config/hermes-ui"
  ( umask 077; printf "HERMES_DASHBOARD_BASIC_AUTH_USERNAME='%s'\nHERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH='%s'\n" "$user" "$hash" \
      > "$HOME/.config/hermes-ui/dashboard.env" )
  unset hash
  sudo -n systemctl restart agent-worker@dashboard
  log "dashboard sign-in set (user $user)"
  echo "Dashboard password set for '$user'. Open http://$(hostname -I | awk '{print $1}'):9119" ;;
vnc)
  if [ -f "$HOME/agents/camofox/run" ]; then unit=camofox
    cred=$(grep -o 'CREDENTIALS_DIRECTORY/[a-z_]*' "$HOME/agents/camofox/run" | head -1 | cut -d/ -f2)
  elif [ -f "$HOME/agents/desktop/run" ]; then unit=desktop; cred=vnc_password
  else echo "No browser view on this machine."; exit 1; fi
  store=/etc/credstore.encrypted
  ask "VNC" 8 --raw | sudo -n systemd-creds encrypt --name="$cred" - "$store/$cred.new" \
    && sudo -n test -s "$store/$cred.new" || { sudo -n rm -f "$store/$cred.new"; echo "Nothing changed."; exit 1; }
  sudo -n mv "$store/$cred.new" "$store/$cred"
  d=/etc/systemd/system/agent-worker@$unit.service.d
  if ! sudo -n grep -qs "LoadCredentialEncrypted=$cred" "$d"/*.conf; then
    sudo -n mkdir -p "$d"; printf '[Service]\nLoadCredentialEncrypted=%s\n' "$cred" | sudo -n tee "$d/vnc.conf" >/dev/null
    sudo -n systemctl daemon-reload
  fi
  sudo -n systemctl restart "agent-worker@$unit"
  log "VNC password re-sealed ($cred), agent-worker@$unit restarted"
  echo "VNC password set (only its first 8 characters count). Open http://$(hostname -I | awk '{print $1}'):6080/vnc.html" ;;
*) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
