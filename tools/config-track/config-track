#!/usr/bin/python3
"""config-track: nightly git history of what steers the agents, and a note when it changed with no log entry.

Snapshots, per profile: SOUL.md (without the ops-rules managed block, which comes from the rule files), config.yaml
(values of keys that look secret are masked), and the cron jobs (name, schedule, prompt, script, state only); plus the
machine's own rule files (~/agents/rules). They go into a local git repo, ~/agents/config-history (never pushed).
Prints nothing unless something changed AND ~/agents/ADMIN-CHANGES.md got no new entry since the last snapshot: then
one short list, so the scheduled job posts it. Run as a no-agent cron job (e.g. 02:45 daily).
Usage: config-track [--dry-run] | config-track --selftest"""
import glob
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile

BEGIN = "<!-- ops-rules:begin"
END = "<!-- ops-rules:end -->"
SECRETY = re.compile(r"^(\s*[\w.-]*(?:key|token|secret|password|passwd|credential)[\w.-]*\s*:\s*)(\S.*)$", re.I)
JOB_KEYS = ("name", "schedule", "schedule_display", "prompt", "script", "monitor_script", "no_agent", "enabled",
            "state", "deliver", "skills", "model", "provider")


def strip_block(soul: str) -> str:
    s, e = soul.find(BEGIN), soul.find(END)
    return soul if s == -1 or e < s else (soul[:s].rstrip("\n") + "\n" + soul[e + len(END):].lstrip("\n"))


def mask(config: str) -> str:
    return "\n".join(SECRETY.sub(lambda m: m.group(1) + ("''" if m.group(2).strip() in ("''", '""', "null", "~") else "<masked>"), l)
                     for l in config.split("\n"))


def jobs(path: str) -> str:
    try:
        d = json.load(open(path, encoding="utf-8"))
    except (OSError, ValueError):
        return ""
    lst = d.get("jobs", d) if isinstance(d, dict) else d
    out = [{k: j.get(k) for k in JOB_KEYS if j.get(k) is not None} | {"id": j.get("id")} for j in lst]
    return json.dumps(sorted(out, key=lambda j: str(j.get("id"))), indent=1, ensure_ascii=False) + "\n"


def collect(hermes: str, rules: str) -> dict:
    """{relative path in the repo: text}"""
    files = {}
    homes = [("default", hermes)] + [(os.path.basename(p), p) for p in sorted(glob.glob(os.path.join(hermes, "profiles", "*")))
                                     if os.path.isdir(p)]
    for name, h in homes:
        for src, dst, fn in (("SOUL.md", "SOUL.md", strip_block), ("config.yaml", "config.yaml", mask)):
            p = os.path.join(h, src)
            if os.path.exists(p):
                files[f"{name}/{dst}"] = fn(open(p, encoding="utf-8", errors="replace").read())
        j = jobs(os.path.join(h, "cron", "jobs.json"))
        if j:
            files[f"{name}/cron-jobs.json"] = j
    for p in sorted(glob.glob(os.path.join(rules, "*.md"))):
        files[f"_rules/{os.path.basename(p)}"] = open(p, encoding="utf-8").read()
    return files


def git(repo, *args):
    return subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True, check=True).stdout


def snapshot(repo: str, files: dict, log_path: str, dry: bool = False) -> list:
    """Write the snapshot and commit; return the changed paths (empty on the first run or when nothing changed)."""
    first = not os.path.isdir(os.path.join(repo, ".git"))
    if first:
        os.makedirs(repo, exist_ok=True)
        git(repo, "init", "-q")
        git(repo, "config", "user.name", "config-track")
        git(repo, "config", "user.email", "config-track@localhost")
    for top in os.listdir(repo):                       # files that disappeared (a deleted profile) show as deletions
        if top != ".git" and top != "state.json":
            shutil.rmtree(os.path.join(repo, top), ignore_errors=True) if os.path.isdir(os.path.join(repo, top)) \
                else os.remove(os.path.join(repo, top))
    for rel, text in files.items():
        p = os.path.join(repo, rel)
        os.makedirs(os.path.dirname(p), exist_ok=True)
        open(p, "w", encoding="utf-8").write(text)
    git(repo, "add", "-A")
    changed = [l[3:] for l in git(repo, "status", "--porcelain").splitlines() if not l.endswith("state.json")]
    state_p = os.path.join(repo, "state.json")
    state = json.load(open(state_p)) if os.path.exists(state_p) else {}
    log_size = os.path.getsize(log_path) if os.path.exists(log_path) else 0
    logged = log_size != state.get("log_size")
    if dry:
        git(repo, "reset", "-q")
        return [] if first or logged else changed
    state["log_size"] = log_size
    json.dump(state, open(state_p, "w"))
    git(repo, "add", "-A")
    if changed or first:
        git(repo, "commit", "-q", "-m", "initial snapshot" if first else ("snapshot (logged)" if logged else "snapshot (no log entry)"))
    return [] if first or logged else changed


def main():
    if sys.argv[1:] == ["--selftest"]:
        return selftest()
    home = os.path.expanduser("~")
    changed = snapshot(os.path.join(home, "agents", "config-history"),
                       collect(os.path.join(home, ".hermes"), os.path.join(home, "agents", "rules")),
                       os.path.join(home, "agents", "ADMIN-CHANGES.md"), dry="--dry-run" in sys.argv)
    if changed:
        shown = ", ".join(changed[:12]) + (f" and {len(changed) - 12} more" if len(changed) > 12 else "")
        print(f"Agent config changed with no ADMIN-CHANGES.md entry since the last snapshot: {shown}. "
              f"What changed: `git -C ~/agents/config-history show`. If you or an agent made it on purpose, add a line to "
              f"ADMIN-CHANGES.md; if nobody did, look into it.")


def selftest():
    with tempfile.TemporaryDirectory() as d:
        h, rules, repo, log = f"{d}/h", f"{d}/rules", f"{d}/repo", f"{d}/ADMIN-CHANGES.md"
        os.makedirs(f"{h}/profiles/qa/cron"); os.makedirs(f"{h}/cron"); os.makedirs(rules)
        w = lambda p, t: open(p, "w", encoding="utf-8").write(t)
        w(f"{h}/SOUL.md", f"You are the admin.\n\n{BEGIN} x -->\n## Shared rules\n- a\n{END}\n")
        w(f"{h}/config.yaml", "model: x\napi_key: sk-123\nbot_token: ''\n")
        w(f"{h}/profiles/qa/SOUL.md", "QA.\n")
        w(f"{h}/profiles/qa/cron/jobs.json", json.dumps({"jobs": [{"id": "a", "name": "n", "schedule": "* * * * *", "next_run_at": "t1"}]}))
        w(log, "- one\n")
        files = collect(h, rules)
        assert files["default/SOUL.md"] == "You are the admin.\n" and "sk-123" not in files["default/config.yaml"]
        assert "api_key: <masked>" in files["default/config.yaml"] and "bot_token: ''" in files["default/config.yaml"]
        assert "next_run_at" not in files["qa/cron-jobs.json"]
        assert snapshot(repo, files, log) == []                                  # first run: silent
        w(f"{h}/profiles/qa/cron/jobs.json", json.dumps({"jobs": [{"id": "a", "name": "n", "schedule": "* * * * *", "next_run_at": "t2"}]}))
        assert snapshot(repo, collect(h, rules), log) == []                      # run bookkeeping is not a change
        w(f"{h}/profiles/qa/SOUL.md", "QA, edited.\n")
        assert snapshot(repo, collect(h, rules), log, dry=True) == ["qa/SOUL.md"]  # dry run reports, commits nothing
        assert snapshot(repo, collect(h, rules), log) == ["qa/SOUL.md"]          # changed, no log entry: reported
        w(f"{h}/profiles/qa/SOUL.md", "QA, edited again.\n"); w(log, "- one\n- two\n")
        assert snapshot(repo, collect(h, rules), log) == []                      # changed with a log entry: silent
        assert snapshot(repo, collect(h, rules), log) == []                      # nothing changed: silent
        shutil.rmtree(f"{h}/profiles/qa")
        assert sorted(snapshot(repo, collect(h, rules), log)) == ["qa/SOUL.md", "qa/cron-jobs.json"]   # a deleted profile shows
    print("config-track selftest ok")


if __name__ == "__main__":
    main()
