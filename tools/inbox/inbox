#!/usr/bin/python3
"""inbox (2026-11-09): one Discord forum post per person, so what waits on each person doesn't get lost in busy threads.
No model calls.

  inbox setup                create the forum channel and one post per person (idempotent; ids saved in the config)
  inbox digest               post each person's full list in their post (daily cron), mentioning them once
  inbox new                  post only items that became theirs since the last run (cron every 10 min; silent if none)
  inbox show [KEY]           print what would be posted, without posting
  inbox note KEY... < FILE   post a one-off note (stdin) in these people's posts, mentioning each once
  inbox --selftest

Config ~/agents/inbox/config.json:
  {"guild": "...", "category": "...", "forum": null, "profile": "<PM profile for pending-human's repo>",
   "default": "<key of the person who gets items with no named owner>",
   "focus": "<optional regex on titles: matching PRs and cards are the current focus and come first>",
   "people": [{"key": "...", "name": "...", "discord": "<user id>", "aliases": ["..."], "github": ["..."], "post": null}]}
Items come from `pending-human` (Kanban cards waiting on people, with their latest reason) and open PRs that need a
person (assignees and review requests by GitHub login). A card belongs to everyone whose alias or <@id> appears in
its reason (the waiting-on-people rule writes "waiting on <person> for <what>"); a card naming nobody goes to the
default person under "Needs an owner". The bot token is read from the sealed credential and never printed."""
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.request

H = os.path.expanduser("~")
CONF = f"{H}/agents/inbox/config.json"
STATE = f"{H}/agents/inbox/state.json"
CRED = "/etc/credstore.encrypted/discord_bot_token"
API = "https://discord.com/api/v10"


def load_pending_human():
    path = next(p for p in (f"{H}/.local/bin/pending-human", f"{H}/agents/src/pending-human/pending-human",
                            os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "pending-human", "pending-human"))
                if os.path.exists(p))
    loader = importlib.machinery.SourceFileLoader("pending_human", path)
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("pending_human", loader))
    loader.exec_module(mod)
    return mod


def token():
    r = subprocess.run(["sudo", "-n", "systemd-creds", "decrypt", CRED, "-"], capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout.strip():
        sys.exit("inbox: can't read the bot token credential")
    return r.stdout.strip()


def api(tok, method, path, body=None):
    req = urllib.request.Request(API + path, method=method, data=json.dumps(body).encode() if body is not None else None,
                                 headers={"Authorization": f"Bot {tok}", "Content-Type": "application/json",
                                          "User-Agent": "DiscordBot (hermes-hive-ops inbox, 1.0)"})
    for attempt in range(3):
        try:
            with urllib.request.urlopen(req, timeout=20) as r:
                return json.loads(r.read() or b"null")
        except urllib.error.HTTPError as e:
            if e.code == 429 and attempt < 2:
                time.sleep(float(json.loads(e.read() or b"{}").get("retry_after", 2)) + 0.5)
                continue
            raise


def waiting_scope(reason):
    """The "<who>" in "waiting on <who> for <what>" (up to " for ", a sentence end or a bracket), or None."""
    w = re.search(r"waiting (?:on|for) (.{0,120}?)(?= for |[.;](?:\s|$)|\(|$)", reason or "", re.I)
    return w.group(1) if w else None


def items_from(cards, prs, people, default, focus=None):
    """{key: [item]} where item = {id, title, summary, link, hours, thread, owner_missing, priority}."""
    out = {p["key"]: [] for p in people}
    for c in cards:
        reason = c.get("reason") or ""
        named = lambda text: [p["key"] for p in people if f"<@{p['discord']}>" in text
                              or any(re.search(rf"(?<![\w@]){re.escape(a)}(?!\w)", text, re.I) for a in p["aliases"])]
        w = waiting_scope(reason)
        if w is not None:
            # "waiting on <person> for <what>" names the owner; "waiting on capacity/another card" is no person's item
            hit = named(w)
            if not hit:
                continue
        elif c.get("status") == "scheduled":
            continue  # parked on time or another event, with no person named: not a human wait
        else:
            hit = named(reason)
        link = re.search(r"https://(?:discord\.com/channels/\S+|github\.com/\S+/(?:pull|issues)/\d+)", reason)
        thread = re.search(r"\b(1[0-9]{17,19})\b", reason)
        item = {"id": c["id"], "title": c.get("title") or "", "summary": the_ask(reason), "hours": c.get("waiting_hours"),
                "link": link.group(0).rstrip(").,;") if link else None, "thread": thread.group(1) if thread else None,
                "owner_missing": not hit}
        for k in hit or [default]:
            out[k].append(item)
    for pr in prs or []:
        logins = {a.get("login", "").lower() for a in pr.get("assignees") or []}
        logins |= {(r.get("login") or "").lower() for r in pr.get("reviewRequests") or []}
        hit = [p["key"] for p in people if logins & {g.lower() for g in p.get("github", [])}] or [default]
        ci = pr.get("_ci")
        note = {"running": " (CI still running)", "failing": " (CI failing: agents fix it first)",
                "none": " (CI hasn't started)"}.get(ci, "")
        for k in hit:
            out[k].append({"id": f"pr{pr['number']}", "title": f"PR #{pr['number']}: {pr['title']}",
                           "summary": (pr.get("_wait") or pr_state(pr)) + note, "hours": None, "link": pr["url"],
                           "thread": None, "owner_missing": False,
                           "priority": 0 if ci in (None, "green") and (not focus or re.search(focus, pr["title"])) else 2})
    # current-focus cards (config "focus" regex on the title) come right after focus PRs ready for a person; the rest by age
    for items in out.values():
        for it in items:
            if "priority" not in it:
                it["priority"] = 1 if focus and re.search(focus, it["title"]) else 3
    return out


def the_ask(reason):
    """The "waiting on <who> for <what>" sentence, which says what the person must do; agents often put a
    "Partly done — ..." status first. Falls back to the first sentence."""
    text = re.sub(r"\s+", " ", reason or "").strip()
    m = re.search(r"waiting (?:on|for) .*?(?:[.;](?=\s|$)|$)", text, re.I)
    if not m:
        return first_sentence(text)
    ask = m.group(0)
    ask = ask[0].upper() + ask[1:]
    return ask if len(ask) <= 220 else ask[:217].rsplit(" ", 1)[0] + "…"


def first_sentence(text):
    text = re.sub(r"\s+", " ", text).strip()
    m = re.match(r"(.{20,180}?[.;:])(\s|$)", text)
    return (m.group(1) if m else text[:180]).strip()


def pr_state(pr):
    labels = {lb["name"] for lb in pr.get("labels") or []}
    if "human-signoff" in labels:
        return "needs a person's sign-off"
    return {"CHANGES_REQUESTED": "changes requested", "REVIEW_REQUIRED": "review requested"}.get(pr.get("reviewDecision"), "needs a person")


ACT_NEXT = 5


def render(person, items, guild, full):
    lines = []
    for it in sorted(items, key=lambda i: (i.get("priority", 3), -(i["hours"] or 0))):
        where = it["link"] or (f"https://discord.com/channels/{guild}/{it['thread']}" if it["thread"] else f"card {it['id']}")
        age = f" · waiting {fmt_age(it['hours'])}" if it["hours"] else ""
        flag = "**Needs an owner:** " if it["owner_missing"] else ""
        lines.append(f"• {flag}{it['title'][:100]}{age}\n  {it['summary']} → {where}")
    if not lines:
        return f"<@{person['discord']}> Nothing is waiting on you today." if full else ""
    if not full:
        return f"<@{person['discord']}> **New for you:**\n" + "\n".join(lines)
    head = (f"<@{person['discord']}> **Waiting on you** ({len(lines)}), most urgent first: PRs ready for you, then the "
            f"current focus, then the rest by age. Reply in each item's own thread; if it isn't yours, say who should take it.")
    if len(lines) <= ACT_NEXT:
        return head + "\n" + "\n".join(lines)
    return (head + "\n**Act next**\n" + "\n".join(lines[:ACT_NEXT]) + f"\n**Also waiting** ({len(lines) - ACT_NEXT})\n"
            + "\n".join(lines[ACT_NEXT:]))


def fmt_age(h):
    return f"{h:.0f}h" if h < 48 else f"{h / 24:.0f} days"


def chunks(text, n=1900):
    out, cur = [], ""
    for line in text.split("\n"):
        if len(cur) + len(line) + 1 > n:
            out.append(cur)
            cur = ""
        cur += line + "\n"
    return [c for c in out + [cur] if c.strip()]


def wait_from_comments(db_path, cards):
    """A card created blocked keeps a placeholder reason ("initial_status") while its worker names the wait in a
    comment: use the newest comment that says "waiting on/for <who>" as the reason for such cards."""
    import sqlite3
    db = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
    try:
        for c in cards:
            if waiting_scope(c.get("reason")) is not None or c.get("status") == "scheduled":
                continue
            for (body,) in db.execute("select body from task_comments where task_id=? order by created_at desc, id desc limit 20",
                                      (c["id"],)):
                m = re.search(r"waiting (?:on|for) .*?(?:[.;](?=\s|$)|$)", re.sub(r"\s+", " ", body or ""), re.I)
                if m and waiting_scope(m.group(0)):
                    c["reason"] = m.group(0)
                    break
    finally:
        db.close()
    return cards


def gather(conf):
    ph = load_pending_human()
    db_path = f"{H}/.hermes/kanban.db"
    cards = wait_from_comments(db_path, ph.waiting_cards(db_path, time.time()))
    repo = ph.REPOS.get(conf.get("profile"), (None, None))[0]
    prs = None
    if repo:
        r = subprocess.run([f"{H}/.local/bin/gh", "pr", "list", "-R", repo, "--json",
                            ph.PR_FIELDS + ",assignees,reviewRequests"],
                           capture_output=True, text=True, timeout=60)
        if r.returncode == 0:
            allp = json.loads(r.stdout or "[]")
            ph.annotate(repo, allp)
            prs = [dict(p, _wait=ph.pr_wait(p), _ci=ph.ci_state(p)) for p in allp if ph.needs_human(p)]
    return items_from(cards, prs, conf["people"], conf["default"], conf.get("focus"))


def setup(conf):
    tok = token()
    if not conf.get("forum"):
        ch = api(tok, "POST", f"/guilds/{conf['guild']}/channels", {
            "name": "inbox", "type": 15, "parent_id": conf.get("category"),
            "topic": "One post per person: what is waiting on you, refreshed every morning, plus a note when something new "
                     "becomes yours. Follow your own post. Reply in each item's own thread."})
        conf["forum"] = ch["id"]
        save(conf)
    for p in conf["people"]:
        if p.get("post"):
            continue
        th = api(tok, "POST", f"/channels/{conf['forum']}/threads", {
            "name": f"Inbox · {p['name']}", "auto_archive_duration": 10080,
            "message": {"content": f"<@{p['discord']}> this is your inbox: every morning the list of what waits on you, "
                                   f"and a short note when something new becomes yours. Follow this post so it stays in "
                                   f"your list.", "allowed_mentions": {"users": [p["discord"]]}}})
        p["post"] = th["id"]
        save(conf)
    print(f"inbox ready: forum {conf['forum']}, {len(conf['people'])} posts")


def post(tok, p, text):
    for part in chunks(text):
        api(tok, "POST", f"/channels/{p['post']}/messages", {"content": part, "allowed_mentions": {"users": [p["discord"]]}})


def save(conf):
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    json.dump(conf, open(CONF, "w"), indent=1)


def main(args):
    if args[:1] == ["--selftest"]:
        return selftest()
    if not os.path.exists(CONF):
        return  # not configured on this machine: nothing to do
    conf = json.load(open(CONF))
    cmd = args[0] if args else "show"
    if cmd == "setup":
        return setup(conf)
    if cmd == "note":
        text = sys.stdin.read().strip()
        who = [p for p in conf["people"] if p["key"] in args[1:] and p.get("post")]
        if not text or not who or len(who) != len(set(args[1:])):
            sys.exit("inbox note: needs the note on stdin and known people keys that have a post")
        tok = token()
        for p in who:
            post(tok, p, f"<@{p['discord']}> {text}")
            print(f"noted in {p['key']}'s inbox")
        return
    items = gather(conf)
    if cmd == "show":
        for p in conf["people"]:
            if not args[1:] or p["key"] in args[1:]:
                print(f"== {p['key']}\n{render(p, items[p['key']], conf['guild'], True)}\n")
        return
    state = json.load(open(STATE)) if os.path.exists(STATE) else {}
    tok = None
    for p in conf["people"]:
        mine = items[p["key"]]
        seen = set(state.get(p["key"], []))
        fresh = [i for i in mine if i["id"] not in seen]
        text = render(p, mine, conf["guild"], True) if cmd == "digest" else render(p, fresh, conf["guild"], False)
        if text and p.get("post") and (cmd == "digest" or (fresh and seen is not None and p["key"] in state)):
            tok = tok or token()
            post(tok, p, text)
        state[p["key"]] = sorted(i["id"] for i in mine)
    json.dump(state, open(STATE, "w"))


def selftest():
    people = [{"key": "r", "name": "R", "discord": "1", "aliases": ["owner1", "Owner"], "github": ["owner-gh"]},
              {"key": "a", "name": "A", "discord": "2", "aliases": ["devops1"], "github": ["ops-gh"]}]
    cards = [{"id": "t_1", "title": "Email sender", "reason": "Waiting on devops1 (provider) and owner1 (DNS) for the answers. "
              "https://discord.com/channels/9/1000000000000000040", "waiting_hours": 30},
             {"id": "t_2", "title": "Notice facts", "reason": "Awaiting the team's answer in thread 1000000000000000050.", "waiting_hours": 3},
             {"id": "t_3", "title": "x", "reason": "Ask <@2> about it.", "waiting_hours": 1},
             {"id": "t_4", "title": "y", "reason": "Ownerxsh-bot detail and @Owner2 aren't Owner's alias? Owner is.", "waiting_hours": 1},
             {"id": "t_5", "title": "z", "reason": "Owner asked for this earlier. Waiting on devops1 for the provider.", "waiting_hours": 2},
             {"id": "t_6", "title": "parked", "status": "scheduled", "waiting_hours": 1,
              "reason": "waiting on capacity after v1.0 (guard off the path, Owner 2026-11-09)"},
             {"id": "t_7", "title": "event", "status": "scheduled", "reason": "Partly done; resumes on the build event.", "waiting_hours": 9}]
    prs = [{"number": 5, "title": "Builds", "url": "https://github.com/o/r/pull/5", "labels": [{"name": "human-signoff"}],
            "assignees": [{"login": "Ops-GH"}], "reviewRequests": []}]
    out = items_from(cards, prs, people, "r")
    assert [i["id"] for i in out["a"]] == ["t_1", "t_3", "t_5", "pr5"], out["a"]   # t_5: only the waiting-on person
    assert [i["id"] for i in out["r"]] == ["t_2", "t_4"], out["r"]   # t_1: one primary owner (before the bracket); t_6/t_7: no person
    assert out["r"][0]["owner_missing"] and not out["r"][1]["owner_missing"]
    assert waiting_scope("waiting on capacity after v1.0 (x, Owner)") == "capacity after v1.0 "
    assert out["a"][0]["link"] == "https://discord.com/channels/9/1000000000000000040"
    assert items_from([{"id": "t_8", "title": "q", "reason": "waiting on devops1 for x (https://discord.com/channels/9/1000000000000000060);"}], [], people, "r")["a"][0]["link"] == "https://discord.com/channels/9/1000000000000000060"
    txt = render(people[0], out["r"], "9", True)
    assert txt.startswith("<@1> **Waiting on you** (2)") and "**Needs an owner:**" in txt and "discord.com/channels/9/1000000000000000050" in txt
    assert render(people[0], [], "9", False) == "" and "Nothing is waiting" in render(people[0], [], "9", True)
    assert all(len(c) <= 1900 for c in chunks("x" * 100 + "\n" + ("y" * 80 + "\n") * 60))
    assert first_sentence("Blocked — needs the four answers: provider, account. More text here.") == "Blocked — needs the four answers:"
    assert the_ask("Partly done — brief v0.2 published. waiting on Owner for the C12 verdict by13Nov and UX0.1 screens. "
                   "More status.") == "Waiting on Owner for the C12 verdict by13Nov and UX0.1 screens."
    assert the_ask("Blocked — needs the four answers: provider, account.") == "Blocked — needs the four answers:"
    assert the_ask("waiting on Owner for " + "x " * 200).endswith("…") and len(the_ask("waiting on Owner for " + "x " * 200)) <= 220
    assert out["a"][2]["summary"] == "Waiting on devops1 for the provider."
    import sqlite3, tempfile
    with tempfile.TemporaryDirectory() as d:
        dbp = f"{d}/k.db"
        db = sqlite3.connect(dbp)
        db.execute("create table task_comments (id integer primary key, task_id text, body text, created_at integer)")
        db.executemany("insert into task_comments (task_id, body, created_at) values (?,?,?)",
                       [("t_9", "Held. waiting on devops1 for the token. More.", 1), ("t_9", "status only, no wait", 2)])
        db.commit(); db.close()
        got = wait_from_comments(dbp, [{"id": "t_9", "status": "blocked", "reason": "initial_status"},
                                       {"id": "t_10", "status": "blocked", "reason": "waiting on owner1 for x"}])
        assert got[0]["reason"] == "waiting on devops1 for the token." and got[1]["reason"] == "waiting on owner1 for x", got
    # order: PRs ready for a person, then current-focus cards, then the rest by age; long lists split into Act next
    pr_ok = {"number": 6, "title": "Login fix", "url": "u6", "labels": [], "_wait": "review requested", "_ci": "green",
             "assignees": [{"login": "owner-gh"}], "reviewRequests": []}
    pr_ci = dict(pr_ok, number=7, title="Login later", url="u7", _ci="running")
    cs = [{"id": f"t_{n}", "title": t, "reason": f"waiting on owner1 for {t}.", "waiting_hours": h}
          for n, t, h in ((20, "old later feature", 90), (21, "login journey", 2), (22, "b", 50), (23, "c", 40), (24, "d", 30))]
    o = items_from(cs, [pr_ok, pr_ci], people, "r", r"(?i)login")["r"]
    order = [i["id"] for i in sorted(o, key=lambda i: (i["priority"], -(i["hours"] or 0)))]
    assert order == ["pr6", "t_21", "pr7", "t_20", "t_22", "t_23", "t_24"], order
    dep = dict(pr_ok, number=8, title="bump deps", url="u8")
    assert items_from([], [dep], people, "r", r"(?i)login")["r"][0]["priority"] == 2   # green but outside the focus
    txt = render(people[0], o, "9", True)
    assert "**Act next**" in txt and "**Also waiting** (2)" in txt and txt.index("PR #6") < txt.index("login journey")
    assert "(CI still running)" in txt
    print("inbox selftest ok")


if __name__ == "__main__":
    main(sys.argv[1:])
