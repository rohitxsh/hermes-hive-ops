#!/usr/bin/python3
"""pending-human (2026-11-04): facts for the PM's evening summary of everything waiting on a person, no model calls.

Prints the Kanban cards that wait on people (blocked other than on a dependency or a transient error, parked in
Scheduled, or held in triage after a block loop), with each one's latest reason, plus the open PRs that need a human
(labelled human-signoff, changes requested, awaiting review, or approved before its latest commits). A PR a person
approved at its current head waits on agents (merge), not on a person, and is left out. The repo comes from ~/agents/pending-human/config.json by profile name; the
Discord guild lets the PM turn thread ids in reasons into links.

  pending-human [--profile NAME]     (default: this profile, from $HERMES_HOME)
  pending-human --selftest
"""
import datetime
import json
import os
import sqlite3
import subprocess
import sys
import time

H = os.path.expanduser("~")
CONFIG = f"{H}/agents/pending-human/config.json"   # {"<profile>": ["<owner/repo>", "<discord guild id>"], ...}
REPOS = {k: tuple(v) for k, v in (json.load(open(CONFIG)) if os.path.exists(CONFIG) else {}).items()}
LOOP_HELD = """(select e.kind from task_events e where e.task_id = t.id and e.kind in
    ('block_loop_detected', 'promoted', 'specified', 'decomposed', 'created') order by e.created_at desc, e.id desc limit 1)
    = 'block_loop_detected'"""


def waiting_cards(db, now):
    c = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=10)
    rows = c.execute(f"""select t.id, t.status, t.assignee, t.title, coalesce(t.block_kind, ''),
        (select max(created_at) from task_events e where e.task_id = t.id and e.kind in ('blocked', 'block_loop_detected', 'scheduled')),
        (select payload from task_events e where e.task_id = t.id and e.kind in ('blocked', 'block_loop_detected', 'scheduled')
         order by created_at desc limit 1)
        from tasks t where t.status in ('blocked', 'scheduled') or (t.status = 'triage' and {LOOP_HELD})
        order by 6""").fetchall()
    c.close()
    out = []
    for tid, status, who, title, kind, since, payload in rows:
        if kind in ("dependency", "transient"):
            continue
        try:
            reason = (json.loads(payload or "{}") or {}).get("reason", "")
        except ValueError:
            reason = ""
        out.append({"id": tid, "status": status, "assignee": who, "title": title, "kind": kind,
                    "waiting_hours": round((now - since) / 3600, 1) if since else None, "reason": reason[:700]})
    return out


PR_FIELDS = "number,title,url,labels,reviewDecision,isDraft,updatedAt,headRefOid,statusCheckRollup"


def human_prs(repo):
    try:
        r = subprocess.run([f"{H}/.local/bin/gh", "pr", "list", "-R", repo, "--json", PR_FIELDS],
                           capture_output=True, text=True, timeout=60)
        prs = json.loads(r.stdout or "[]") if r.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired, ValueError):
        prs = None
    if prs is None:
        return None
    annotate(repo, prs)
    out = [p for p in prs if needs_human(p)]
    for p in out:
        p.update(waits_for=pr_wait(p), ci=ci_state(p))
        p.pop("statusCheckRollup", None)
    return out


def annotate(repo, prs):
    """Sets approved_at_head on APPROVED PRs: a person approved the commit the PR has now (reviewDecision alone
    stays APPROVED after new commits, since the repo has no branch protection to dismiss stale approvals)."""
    for p in prs:
        if p.get("reviewDecision") != "APPROVED" or not p.get("headRefOid"):
            continue
        try:
            r = subprocess.run([f"{H}/.local/bin/gh", "api", "--paginate", f"repos/{repo}/pulls/{p['number']}/reviews",
                                "--jq", '.[] | select(.state == "APPROVED") | .commit_id'],
                               capture_output=True, text=True, timeout=60)
            p["approved_at_head"] = r.returncode == 0 and p["headRefOid"] in r.stdout.split()
        except (OSError, subprocess.TimeoutExpired):
            p["approved_at_head"] = False


def ci_state(p):
    """'green', 'running', 'failing' or 'none' (no checks reported yet, e.g. a run stuck in queued)."""
    runs = p.get("statusCheckRollup") or []
    if not runs:
        return "none"
    if any((c.get("conclusion") or c.get("state") or "").upper() in ("FAILURE", "ERROR", "TIMED_OUT", "CANCELLED") for c in runs):
        return "failing"
    if any((c.get("status") or "COMPLETED").upper() != "COMPLETED" or (c.get("state") or "").upper() == "PENDING" for c in runs):
        return "running"
    return "green"


def pr_wait(p):
    """What a person must do on this PR, or None when it waits on agents (approved at its head: an agent merges)."""
    labels = {(l.get("name") or "").lower() for l in p.get("labels") or []}
    if p.get("isDraft") or p.get("approved_at_head"):
        return None
    if p.get("reviewDecision") == "CHANGES_REQUESTED":
        return "changes requested"
    if p.get("reviewDecision") == "APPROVED":   # approved, but not this commit
        return "approval is stale: new commits since it was approved"
    if "human-signoff" in labels:
        return "needs a person's sign-off"
    if p.get("reviewDecision") == "REVIEW_REQUIRED":
        return "review requested"
    return None


def needs_human(p):
    return pr_wait(p) is not None


def main(args):
    if args[:1] == ["--selftest"]:
        return selftest()
    prof = args[args.index("--profile") + 1] if "--profile" in args else os.path.basename(os.environ.get("HERMES_HOME", "").rstrip("/"))
    repo, guild = REPOS.get(prof, (None, None))
    now = time.time()
    print(f"Pending-human facts for profile {prof}, {datetime.datetime.now():%Y-%m-%d %H:%M}. Discord guild id {guild} "
          f"(thread links: https://discord.com/channels/{guild}/<thread id>).")
    cards = waiting_cards(f"{H}/.hermes/kanban.db", now)
    print(f"\nKanban cards not running and not waiting on another card ({len(cards)}):")
    print(json.dumps(cards, indent=1) if cards else "none")
    if repo:
        prs = human_prs(repo)
        print(f"\nOpen PRs in {repo} that need a person ({'unreadable' if prs is None else len(prs)}):")
        print(json.dumps(prs, indent=1) if prs else "none")


def selftest():
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        db = f"{d}/k.db"
        c = sqlite3.connect(db)
        c.executescript("""create table tasks (id, status, assignee, title, block_kind);
            create table task_events (id integer primary key, task_id, kind, created_at, payload);
            insert into tasks values ('a', 'blocked', 'pm', 'needs a human', 'needs_input'),
              ('b', 'blocked', 'dev', 'waits on a card', 'dependency'), ('c', 'running', 'qa', 'busy', null),
              ('d', 'triage', 'dev', 'loop held', null), ('e', 'triage', 'dev', 'fresh triage', null),
              ('f', 'scheduled', 'dev', 'parked', null);
            insert into task_events (task_id, kind, created_at, payload) values
              ('a', 'blocked', 100, '{"reason": "approve the PRD?"}'), ('d', 'block_loop_detected', 50, '{}'),
              ('e', 'created', 60, '{}'), ('f', 'scheduled', 70, '{"reason": "waiting on QA"}');""")
        c.commit(); c.close()
        got = {x["id"]: x for x in waiting_cards(db, 3700)}
        assert set(got) == {"a", "d", "f"}, got
        assert got["a"]["reason"] == "approve the PRD?" and got["a"]["waiting_hours"] == 1.0
    so = {"labels": [{"name": "human-signoff"}], "reviewDecision": "APPROVED", "headRefOid": "h2"}
    assert not needs_human(dict(so, approved_at_head=True))          # approved at its head: an agent merges it
    assert pr_wait(dict(so, approved_at_head=False)).startswith("approval is stale")
    assert pr_wait({"labels": [{"name": "human-signoff"}], "reviewDecision": ""}) == "needs a person's sign-off"
    assert pr_wait({"labels": [], "reviewDecision": "CHANGES_REQUESTED"}) == "changes requested"
    assert ci_state({"statusCheckRollup": []}) == "none"
    assert ci_state({"statusCheckRollup": [{"status": "COMPLETED", "conclusion": "SUCCESS"}]}) == "green"
    assert ci_state({"statusCheckRollup": [{"status": "IN_PROGRESS", "conclusion": ""}]}) == "running"
    assert ci_state({"statusCheckRollup": [{"status": "COMPLETED", "conclusion": "FAILURE"}]}) == "failing"
    assert not needs_human({"isDraft": True, "labels": [], "reviewDecision": "REVIEW_REQUIRED"})
    print("selftest ok")


if __name__ == "__main__":
    main(sys.argv[1:])
