#!/bin/bash
# local-supabase: one trimmed, loopback-published local Supabase stack per VM.
# Synthetic data only; never point this at a hosted project or use customer data.
#   local-supabase start <repo-dir>   start on a helper-owned loopback bridge; RAM minimum 3000 MB
#   local-supabase status <repo-dir>  allowlisted local API/public key/mailbox fields (JSON; no privileged keys)
#   local-supabase code <email>       newest synthetic 6-digit code from the loopback test mailbox
#   local-supabase stop <repo-dir>    stop only the owned stack and delete its disposable volumes/network
#   local-supabase --selftest
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
EXCLUDE=studio,realtime,storage-api,imgproxy,edge-runtime,logflare,vector,supavisor,postgres-meta
MIN_MB=${LOCAL_SUPABASE_MIN_MB:-3000}
MAILPIT=${LOCAL_SUPABASE_MAILPIT:-http://127.0.0.1:54324}
cmd=${1:-}; arg=${2:-}
running() { docker ps -a --format '{{.Names}}' | grep -E '^supabase_' || true; }
usage() { sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; }
identity() {
  [ -n "$arg" ] && [ -f "$arg/supabase/config.toml" ] || { echo 'repo supabase/config.toml missing' >&2; exit 2; }
  arg=$(realpath "$arg")
  project=$(python3 - "$arg/supabase/config.toml" <<'PY'
import re, sys, tomllib
with open(sys.argv[1], 'rb') as f: p = tomllib.load(f).get('project_id', '')
if not re.fullmatch(r'[A-Za-z0-9_-]+', p): sys.exit('invalid local project_id')
print(p)
PY
)
  network="local-supabase-$(printf '%s\n%s' "$arg" "$project" | sha256sum | cut -c1-16)"
}
owned() {
  local labels
  labels=$(docker network inspect --format '{{index .Labels "local-supabase.repo"}}|{{index .Labels "local-supabase.project"}}' "$network") || return 1
  [ "$labels" = "$arg|$project" ] || { echo 'refusing network not owned by this repo/project' >&2; return 1; }
  # A project ID alone is not ownership: refuse same-project containers on another network.
  local ids
  ids=$(docker ps -aq)
  [ -z "$ids" ] || docker inspect --format '{{json .Name}} {{json .NetworkSettings.Networks}}' $ids | python3 -c '
import json, sys
project, network = sys.argv[1:]
for line in sys.stdin:
    d = json.JSONDecoder(); name, end = d.raw_decode(line); nets = json.loads(line[end:])
    if name.startswith("/supabase_") and name.endswith("_" + project) and network not in nets:
        sys.exit("refusing same-project container outside owned network")
' "$project" "$network"
}
check_ports() {
  local ids
  ids=$(docker ps -q --filter "network=$network")
  [ -n "$ids" ] || { echo 'no running containers on owned network' >&2; return 1; }
  docker inspect --format '{{json .NetworkSettings.Ports}}' $ids | python3 -c '
import json, sys
count = 0
for line in sys.stdin:
    for bindings in json.loads(line).values():
        for binding in bindings or []:
            count += 1
            if binding.get("HostIp") not in ("127.0.0.1", "::1"):
                sys.exit("unsafe non-loopback published port; refusing local tests")
if not count: sys.exit("no effective published ports to verify")
print("local-supabase: all %d published mappings are loopback-only" % count, file=sys.stderr)
'
}
stop_owned() {
  owned || { echo 'refusing stop: no matching helper-owned network; use the original owner/runbook' >&2; return 5; }
  supabase stop --workdir "$arg" --network-id "$network" --no-backup >/dev/null
  docker network rm "$network" >/dev/null
}
code_for() {
  python3 - "$MAILPIT" "$1" <<'PY'
import ipaddress, json, re, sys, urllib.parse, urllib.request
base, email = sys.argv[1], sys.argv[2]
u = urllib.parse.urlsplit(base)
try: local = ipaddress.ip_address(u.hostname).is_loopback
except ValueError: local = False
if u.scheme != 'http' or not local or u.username or u.password or u.query or u.fragment or u.path not in ('', '/'):
    sys.exit('mailbox must be a literal loopback HTTP URL')
class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs): raise ValueError('mailbox redirects forbidden')
opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect())
def get(path):
    with opener.open(base.rstrip('/') + path, timeout=10) as r: return json.load(r)
q = urllib.parse.urlencode({'query': f'to:"{email}"', 'limit': 1})
msgs = get('/api/v1/search?' + q).get('messages') or []
if not msgs: sys.exit('no message in the local test mailbox')
m = get('/api/v1/message/' + urllib.parse.quote(msgs[0]['ID'], safe=''))
codes = re.findall(r'(?<![A-Za-z0-9])(\d{6})(?![A-Za-z0-9])', (m.get('Text') or '') + ' ' + re.sub(r'<[^>]+>', ' ', m.get('HTML') or ''))
if not codes: sys.exit('newest message has no 6-digit code')
print(codes[0])
PY
}
case "$cmd" in
  start|stop|status)
    identity
    # Serialize this helper's lifecycle; native CLI users must still coordinate the shared VM slot.
    mkdir -p "$HOME/.cache/local-supabase"
    exec 9>"$HOME/.cache/local-supabase/lifecycle.lock"
    flock -n 9 || { echo 'another local-supabase lifecycle command is active' >&2; exit 3; }
    case "$cmd" in
      start)
        r=$(running); [ -z "$r" ] || { printf 'a local Supabase stack already exists (one per VM); contact its owner:\n%s\n' "$r" >&2; exit 3; }
        avail=$(awk '/MemAvailable/ {print int($2/1024)}' /proc/meminfo)
        [ "$avail" -ge "$MIN_MB" ] || { echo "only ${avail} MB RAM available (needs ${MIN_MB}); wait or use CI" >&2; exit 4; }
        [ -z "$(docker volume ls --format '{{.Name}}' | grep -F "_$project" || true)" ] || { echo 'existing project volumes; refusing to reuse unknown data' >&2; exit 5; }
        # Refuse reuse: a failed prior run must be stopped with its original repo/config first.
        docker network create --driver bridge --label "local-supabase.repo=$arg" --label "local-supabase.project=$project" --opt com.docker.network.bridge.host_binding_ipv4=127.0.0.1 "$network" >/dev/null
        if supabase start --workdir "$arg" --network-id "$network" -x "$EXCLUDE" >/dev/null; then
          if check_ports; then exit 0; fi
        fi
        echo 'start/port validation failed; cleaning only the owned disposable stack' >&2
        stop_owned
        exit 6 ;;
      stop) stop_owned ;;
      status)
        owned || exit 5
        check_ports || exit 6
        supabase status --workdir "$arg" --network-id "$network" -o json | python3 -c 'import json,sys; d=json.load(sys.stdin); print(json.dumps({k:v for k,v in d.items() if k in ("API_URL", "ANON_KEY", "PUBLISHABLE_KEY", "INBUCKET_URL", "MAILPIT_URL")}))' ;;
    esac ;;
  code) [ -n "$arg" ] || { usage; exit 2; }; code_for "$arg" ;;
  --selftest)
    [ "$(printf 'Your code is 123456\n' | grep -oE '[0-9]{6}')" = 123456 ] && grep -q storage-api <<< "$EXCLUDE" && echo 'local-supabase selftest ok' ;;
  *) usage; [ -z "$cmd" ] || [ "$cmd" = -h ] || [ "$cmd" = --help ] || exit 2 ;;
esac
