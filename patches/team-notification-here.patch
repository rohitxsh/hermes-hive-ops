+def _team_notification_payload(content: str, *, enabled: bool, notify: bool = False,
+                               can_silence: bool = False) -> tuple[str, dict]:
+    """Opt-in @here only: preserve the safe client default and neutralize body broadcasts.
+    A leading @silent (Discord's own convention) wins: the token is dropped, no @here is added, and where
+    the caller sends a new message it goes out without a push or sound. Cron output must keep text on the
+    same line ("@silent **Report**"): the scheduler reads a first line of only "@silent" as [SILENT]."""
+    silent = re.match(r"^\s*@silent(?:[ \t]+|[ \t]*(?:\n|$))", content)
+    if silent:
+        return content[silent.end():], ({"silent": True} if can_silence else {})
+    if not enabled or not (notify or re.match(r"^\s*@here(?:\s|$)", content)):
+        return content, {}
+    body = content.lstrip()
+    prefix = r"^(?:@here(?=\s|$)|@Owner(?=\s|$)|<@!?100000000000000001>)\s*"
+    while re.match(prefix, body):
+        body = re.sub(prefix, "", body, count=1)
+    body = body.replace("@everyone", "＠everyone").replace("@here", "＠here")
+    return "@here\n" + body, {"allowed_mentions": discord.AllowedMentions(
+        everyone=True, roles=False, users=False, replied_user=False,
+    )}
+
