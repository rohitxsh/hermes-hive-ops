+def _team_notification_payload(content: str, *, enabled: bool, notify: bool = False) -> tuple[str, dict]:
+    """Opt-in @here only: preserve the safe client default and neutralize body broadcasts."""
+    if not enabled or not (notify or re.match(r"^\s*@here(?:\s|$)", content)):
+        return content, {}
+    body = content.lstrip()
+    prefix = r"^(?:@here(?=\s|$)|@Owner(?=\s|$)|<@!?100000000000000001>)\s*"
+    while re.match(prefix, body):
+        body = re.sub(prefix, "", body, count=1)
+    body = body.replace("@everyone", "＠everyone").replace("@here", "＠here")
+    return "@here\n" + body, {"allowed_mentions": discord.AllowedMentions(
+        everyone=True, roles=False, users=False, replied_user=False,
+    )}
 
 
